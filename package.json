{
    "name": "microloan",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "pnpm run lint && pnpm run typecheck && pnpm --filter db run prisma:validate",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "db:push": "node ./scripts/guarded-db-push.mjs",
        "db:migrate:deploy": "pnpm --filter db migrate:deploy",
        "db:seed": "pnpm --filter db db:seed",
        "encrypt:backfill": "tsx apps/api/src/scripts/encrypt-at-rest-backfill.ts",
        "encrypt:documents": "tsx apps/api/src/scripts/encrypt-documents-at-rest.ts",
        "start": "pnpm run db:migrate:deploy && eval \"${START_COMMAND:-node apps/api/dist/main}\"",
        "security:scan-hardcodes": "node ./scripts/security-scan.mjs hardcodes",
        "security:scan-timebombs": "node ./scripts/security-scan.mjs timebombs",
        "security:scan-memory-stores": "node ./scripts/security-scan.mjs memory",
        "security:prod-config-check": "node ./scripts/prod-config-check.mjs",
        "security:config-audit": "node ./scripts/config-audit.mjs",
        "security:ci": "pnpm run security:scan-hardcodes && pnpm run security:scan-timebombs && pnpm run security:scan-memory-stores && pnpm run security:config-audit && pnpm run security:prod-config-check",
        "test:engine": "pnpm --filter @microloan/shared test",
        "test:api": "pnpm --filter api test",
        "test:lending:int": "pnpm --filter api test:lending:int",
        "demo:lending": "pnpm --filter @microloan/db demo:lending",
        "docs:capabilities": "pnpm --filter @microloan/shared build && node scripts/lending-capability-matrix.mjs",
        "test:lending:db": "node scripts/lending-test-db.mjs",
        "db:check-migrations": "node scripts/check-migrations.mjs",
        "db:mark-baseline-applied": "node scripts/mark-baseline-applied.mjs",
        "lint:changed-lending": "node scripts/lint-changed-lending.mjs",
        "load:lending:seed": "pnpm --filter api exec ts-node -T test/load/seed.ts",
        "load:lending:run": "pnpm --filter api exec ts-node -T test/load/run.ts"
    },
    "devDependencies": {
        "prettier": "^3.2.5",
        "tsx": "^4.21.0",
        "turbo": "^1.13.0",
        "typescript": "^5.4.5"
    },
    "engines": {
        "node": ">=22 <23"
    },
    "packageManager": "pnpm@9.0.0",
    "pnpm": {
        "overrides": {
            "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.2",
            "fast-xml-parser@>=5.0.0 <5.5.6": "^5.11.2",
            "multer@<2.4.0": "^2.4.0",
            "proxy-addr@<2.0.8": "^2.0.8",
            "form-data@>=4.0.0 <4.0.6": "^4.0.6",
            "ip-address@>=10.0.0 <10.3.1": "^10.3.1",
            "picomatch@>=4.0.0 <4.0.4": "^4.0.7",
            "browserslist@<4.28.7": "4.29.3",
            "source-map-js@<1.2.2": "^1.2.2",
            "qs@>=6.0.0 <6.16.0": "6.16.0",
            "body-parser@>=2.0.0 <2.3.0": "2.3.0",
            "baseline-browser-mapping@<2.11.0": "2.11.26"
        }
    }
}
