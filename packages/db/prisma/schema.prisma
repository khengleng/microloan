generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String    @id @default(uuid())
  name                     String
  telegramBotToken         String?   @unique // Per-tenant bot token
  plan                     String    @default("FREE") // Basic subscription visibility
  status                   String    @default("ACTIVE") // ACTIVE, SUSPENDED
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  // Fix 5: configurable late penalty in $USD per overdue installment per day
  penaltyRatePerDay        Decimal   @default(10.00) @db.Decimal(8, 2)
  // Feature #1: dual-currency — the tenant's reporting/base currency.
  baseCurrency             Currency  @default(USD)
  // Feature #1: per-tenant interest ceiling (%). Never exceeds NBC cap of 18%.
  maxAnnualInterestRatePct Decimal   @default(18.00) @db.Decimal(5, 2)
  // Feature #3: require a completed CBC credit check before a loan can be approved.
  requireCreditCheckForApproval Boolean @default(true)
  // Days a completed credit check stays valid for approval purposes.
  creditCheckValidityDays       Int     @default(90)
  // Fix 9: GDPR soft-delete — set when erasure is requested, hard-delete job runs after 30 days
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  users          User[]
  branches       Branch[]
  borrowers      Borrower[]
  loans          Loan[]
  repayments     Repayment[]
  auditLogs      AuditLog[]
  documents      Document[]
  loanProducts   LoanProduct[]
  exchangeRates  ExchangeRate[]
  ledgerAccounts LedgerAccount[]
  journalEntries JournalEntry[]
  provisionRuns  ProvisionRun[]
  creditChecks   CreditCheck[]
  promisesToPay  PromiseToPay[]
  paymentInstruments PaymentInstrument[]
  loanAgreements LoanAgreement[]
}

enum Currency {
  USD
  KHR
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  BRANCH_MANAGER
  LOAN_OFFICER
  CREDIT_OFFICER
  APPROVER
  ACCOUNTANT
  AUDITOR
  CUSTOMER_SUPPORT
  BORROWER
  // Legacy roles kept for backward compatibility during migration.
  ADMIN
  OPERATOR
  FINANCE
  SALES
  CX
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  borrowers Borrower[]
  loans     Loan[]
  paymentInstruments PaymentInstrument[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email            String    @unique
  passwordHash     String
  twoFactorSecret  String? // For MFA
  twoFactorEnabled Boolean   @default(false)
  isActive         Boolean   @default(true) // For soft delete / suspension
  role             Role      @default(LOAN_OFFICER)
  telegramChatId   String? // Staff's telegram chat ID
  loginAttempts    Int       @default(0) // Brute-force counter
  lockedUntil      DateTime? // Account locked until this timestamp
  lastLoginAt      DateTime? // Last successful login
  lastLoginIp      String? // Last known IP for anomaly detection
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([tenantId])
  @@index([branchId])
  @@index([email])
}

// Self-service password reset (forgot-password). The raw token is emailed; only
// its hash is stored. Single-use, short-lived.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  // JWT jti (unique per issued refresh token)
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Borrower {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  phone          String?
  email          String?
  address        String?
  idNumber       String?  @unique
  telegramChatId String?
  // P0 #4: basic KYC capture + manual KYC/AML status (no external screening).
  dateOfBirth        DateTime?
  idType             String? // e.g., NATIONAL_ID, PASSPORT, FAMILY_BOOK
  occupation         String?
  // Risk Batch #7: affordability / debt-service-ratio inputs
  monthlyIncome      Decimal?  @db.Decimal(12, 2)
  monthlyExpenses    Decimal?  @db.Decimal(12, 2)
  kycStatus          KycStatus @default(PENDING)
  kycVerifiedAt      DateTime?
  kycVerifiedByUserId String?
  amlStatus          AmlStatus @default(NOT_SCREENED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loans        Loan[]
  creditChecks CreditCheck[]
  kycDocuments KycDocument[]
  otps         BorrowerOtp[]

  @@index([tenantId, branchId])
}

// ── CX Batch #6: Borrower self-service portal (phone + OTP auth) ─────────────
// A short-lived one-time code is SMS'd to the borrower's phone. Only the hash
// is stored (sha256 + pepper), single-use, attempt-capped. On success the API
// issues a borrower-scoped JWT (typ=borrower) kept in an HttpOnly cookie.
model BorrowerOtp {
  id         String    @id @default(uuid())
  phone      String
  borrowerId String
  borrower   Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  tenantId   String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@index([borrowerId])
}

// ── CX Batch #6: Manual e-KYC — borrower-uploaded identity documents ─────────
// Stored as a base64 data URI or URL (mirrors Document). Staff review flips the
// borrower's aggregate kycStatus; per-document status is advisory.
model KycDocument {
  id         String   @id @default(uuid())
  tenantId   String
  borrowerId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  type       String // e.g. NATIONAL_ID_FRONT, NATIONAL_ID_BACK, SELFIE, PROOF_OF_ADDRESS
  content    String   @db.Text
  mimeType   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, borrowerId])
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AmlStatus {
  NOT_SCREENED
  CLEAR
  FLAGGED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
  DEFAULTED
  WRITTEN_OFF
}

enum InterestMethod {
  FLAT
  REDUCING_BALANCE
}

model LoanProduct {
  id                String         @id @default(uuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String // e.g., "Daily Loan", "Weekly Loan", "Mortgage Loan"
  description       String?
  interestMethod    InterestMethod
  currency          Currency       @default(USD)
  isActive          Boolean        @default(true)
  // Fix 5: per-product penalty override (null = use tenant default)
  penaltyRatePerDay Decimal?       @db.Decimal(8, 2)
  // P1 #11: origination fees applied at disbursement (deducted from disbursed cash,
  // recognised as fee income). Processing fee = % of principal; admin fee = flat.
  processingFeePct  Decimal?       @db.Decimal(5, 2)
  adminFee          Decimal?       @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  policies LoanPolicy[]
  loans    Loan[]
}

model LoanPolicy {
  id            String      @id @default(uuid())
  productId     String
  product       LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  creditRating  String // e.g., "A", "B", "C", "EXCELLENT", "GOOD", "FAIR"
  interestRate  Decimal     @db.Decimal(5, 2)
  minTermMonths Int?
  maxTermMonths Int?
  minPrincipal  Decimal?    @db.Decimal(10, 2)
  maxPrincipal  Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Loan {
  id                  String         @id @default(uuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  borrowerId          String
  borrower            Borrower       @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  productId           String?
  product             LoanProduct?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  creditRatingApplied String?
  status              LoanStatus     @default(PENDING)
  principal           Decimal        @db.Decimal(10, 2)
  annualInterestRate  Decimal        @db.Decimal(5, 2)
  termMonths          Int
  interestMethod      InterestMethod
  // Feature #1: currency the loan is booked and repaid in.
  currency            Currency       @default(USD)
  // Feature #1: FX rate (loan currency -> tenant base currency) captured at
  // disbursement, so historical portfolio value in base currency is stable.
  fxRateToBase        Decimal?       @db.Decimal(18, 8)
  // P1 #11: origination fee charged at disbursement (snapshot).
  feeCharged          Decimal        @default(0) @db.Decimal(10, 2)
  startDate           DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  schedules         RepaymentSchedule[]
  repayments        Repayment[]
  documents         Document[]
  collaterals       Collateral[]
  guarantors        Guarantor[]
  interactions      LoanInteraction[]
  provisions        LoanProvision[]
  journalEntries    JournalEntry[]
  promisesToPay     PromiseToPay[]
  agreements        LoanAgreement[]
  createdByUserId   String?
  reviewedByUserId  String?
  disbursedByUserId String?

  // Approval Workflow Fields
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  // P1 #9: write-off audit trail
  writtenOffAt       DateTime?
  writtenOffByUserId String?
  writeOffReason     String?

  // Risk Batch #7: restructuring / rescheduling
  isRestructured   Boolean   @default(false)
  restructuredAt   DateTime?
  restructureCount Int       @default(0)

  creditScores CreditScore[]
  restructures LoanRestructure[]

  @@index([tenantId, branchId])
}

// ── Risk Batch #7: internal scorecard result (persisted, explainable) ───────
model CreditScore {
  id              String   @id @default(uuid())
  tenantId        String
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  borrowerId      String
  score           Int
  grade           String
  decision        String // APPROVE | REFER | DECLINE
  dsr             Decimal? @db.Decimal(6, 4)
  recommendedRate Decimal? @db.Decimal(5, 2)
  factors         Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId, loanId])
}

// ── Risk Batch #7: loan restructuring / rescheduling audit ──────────────────
model LoanRestructure {
  id                    String   @id @default(uuid())
  tenantId              String
  loanId                String
  loan                  Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  reason                String
  oldTermMonths         Int
  oldAnnualInterestRate Decimal  @db.Decimal(5, 2)
  oldOutstanding        Decimal  @db.Decimal(12, 2)
  newTermMonths         Int
  newAnnualInterestRate Decimal  @db.Decimal(5, 2)
  createdByUserId       String?
  createdAt             DateTime @default(now())

  @@index([tenantId, loanId])
}

model Collateral {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type        String // e.g., "LAND_TITLE", "VEHICLE", "GOLD", "OTHER"
  description String
  value       Decimal  @db.Decimal(10, 2)
  idNumber    String? // e.g., Land title number or license plate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guarantor {
  id        String   @id @default(uuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  idNumber  String?
  relation  String? // e.g., "SPOUSE", "PARENT", "COLLEAGUE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanInteraction {
  id        String   @id @default(uuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  title     String? // e.g., "Follow-up Call", "Home Visit"
  notes     String
  type      String   @default("NOTE") // NOTE, CALL, VISIT, SYSTEM
  createdAt DateTime @default(now())
}

model RepaymentSchedule {
  id                   String    @id @default(uuid())
  loanId               String
  loan                 Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber    Int
  dueDate              DateTime
  principalAmount      Decimal   @db.Decimal(10, 2)
  interestAmount       Decimal   @db.Decimal(10, 2)
  penaltyAmount        Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal   @db.Decimal(10, 2)
  outstandingPrincipal Decimal   @db.Decimal(10, 2)
  paidPrincipal        Decimal   @default(0) @db.Decimal(10, 2)
  paidInterest         Decimal   @default(0) @db.Decimal(10, 2)
  paidPenalty          Decimal   @default(0) @db.Decimal(10, 2)
  isPaid               Boolean   @default(false)
  penaltyLastAppliedAt DateTime? // Guard: ensures penalty is applied at most once per day
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Repayment {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId        String
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(10, 2)
  currency      Currency @default(USD)
  principalPaid Decimal  @default(0) @db.Decimal(10, 2)
  interestPaid  Decimal  @default(0) @db.Decimal(10, 2)
  penaltyPaid   Decimal  @default(0) @db.Decimal(10, 2)
  date          DateTime @default(now())
  // P0 #2: client-supplied dedupe key — a retried/double-submitted repayment with
  // the same key returns the original instead of posting twice. NULLs are allowed
  // and treated as distinct by Postgres, so keyless posts are unaffected.
  idempotencyKey String?
  // P1 #13: reversal audit trail (a reversed repayment is excluded from balances).
  reversedAt        DateTime?
  reversedByUserId  String?
  reversalReason    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String? // Nullable  — allows anonymous security events (e.g. unknown email login)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN
  entity    String // Borrower, Loan, Repayment, User, Tenant
  entityId  String
  metadata  Json? // Masked metadata only — never raw PII
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([userId])
}

model Document {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name      String
  content   String   @db.Text // Base64 content or public URL
  type      String // e.g., "application/pdf", "image/png", or "url"
  createdAt DateTime @default(now())
}

// ── Feature #1: Multi-currency FX rates ─────────────────────────────────────
// Tenant-scoped exchange rates. `rate` = units of `toCurrency` per 1 unit of
// `fromCurrency`. Rates are effective-dated; the latest effective rate at or
// before a transaction date is used.
model ExchangeRate {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency  Currency
  toCurrency    Currency
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, fromCurrency, toCurrency, effectiveDate])
}

// ── Feature #3: General Ledger (double-entry) ───────────────────────────────
enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSource {
  DISBURSEMENT
  REPAYMENT
  PENALTY
  PROVISION
  WRITEOFF
  MANUAL
}

model LedgerAccount {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String // e.g., "1000" cash, "1200" loans receivable
  name      String
  type      LedgerAccountType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JournalEntry {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date            DateTime      @default(now())
  source          JournalSource
  currency        Currency      @default(USD)
  description     String
  // Optional linkage to the business object that produced this entry.
  loanId          String?
  loan            Loan?         @relation(fields: [loanId], references: [id], onDelete: SetNull)
  referenceId     String? // repaymentId, provisionRunId, etc.
  createdByUserId String?
  createdAt       DateTime      @default(now())

  lines JournalLine[]

  @@index([tenantId, date])
  @@index([tenantId, source])
  @@index([loanId])
}

model JournalLine {
  id        String        @id @default(uuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Decimal       @default(0) @db.Decimal(18, 2)
  credit    Decimal       @default(0) @db.Decimal(18, 2)

  @@index([entryId])
  @@index([accountId])
}

// ── Feature #3: Loan-loss provisioning (NBC classification) ─────────────────
enum LoanClassification {
  STANDARD
  SPECIAL_MENTION
  SUBSTANDARD
  DOUBTFUL
  LOSS
}

model ProvisionRun {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runDate         DateTime @default(now())
  totalProvision  Decimal  @default(0) @db.Decimal(18, 2)
  loanCount       Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())

  provisions LoanProvision[]

  @@index([tenantId, runDate])
}

model LoanProvision {
  id                   String             @id @default(uuid())
  runId                String
  run                  ProvisionRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  loanId               String
  loan                 Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  daysOverdue          Int
  classification       LoanClassification
  outstandingPrincipal Decimal            @db.Decimal(18, 2)
  provisionRate        Decimal            @db.Decimal(6, 4)
  provisionAmount      Decimal            @db.Decimal(18, 2)
  currency             Currency           @default(USD)

  @@index([runId])
  @@index([loanId])
}

// ── Feature #3: Credit Bureau Cambodia (CBC) checks ─────────────────────────
enum CreditCheckStatus {
  PENDING
  COMPLETED
  FAILED
}

model CreditCheck {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  borrowerId        String
  borrower          Borrower          @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  provider          String            @default("CBC")
  status            CreditCheckStatus @default(PENDING)
  score             Int? // bureau score (nullable until completed)
  grade             String? // e.g., "A".."E"
  reportRef         String? // bureau reference id
  summary           String? // human-readable summary (no raw PII)
  requestedByUserId String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  @@index([tenantId, borrowerId])
}

// ── Payments Batch #P1: Static-QR payment rail (display-only) ────────────────
// A tenant (optionally per-branch) stores its static collection QR — either the
// KHQR/EMVCo payload string (rendered to an image on demand) or an uploaded QR
// image (base64/URL). Disbursement stays manual and repayments are still posted
// by an officer; the QR is a payer convenience shown on loans, receipts and the
// borrower portal. `resolveForLoan` prefers a branch instrument, else the tenant
// default.
model PaymentInstrument {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  label         String // e.g. "ABA Main", "Bakong - HQ"
  bankName      String?
  accountName   String?
  accountNumber String?
  // KHQR / EMVCo static payload string. When present it is rendered to a QR
  // image server-side (qrcode lib). Never contains an amount for a static QR.
  qrPayload     String?  @db.Text
  // Fallback: an uploaded QR image (base64 data URI or public URL) when only an
  // image is available and no payload string can be provided.
  qrImage       String?  @db.Text
  currency      Currency @default(USD)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, branchId])
}

// ── Compliance Batch #4: Key Facts Statement + e-signature ──────────────────
// An immutable, hash-anchored record that a borrower (or staff on their behalf)
// was shown the Key Facts (principal, nominal rate, EIR/APR, total cost of
// credit) and signed the loan agreement. keyFacts is the snapshot at signing;
// agreementHash binds the exact disclosed terms so tampering is detectable.
model LoanAgreement {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  version            Int      @default(1)
  keyFacts           Json // Key Facts snapshot (EIR, totals) at signing
  agreementHash      String // sha256 over canonical disclosed terms
  signatureName      String? // typed signer name
  signatureImage     String?  @db.Text // drawn signature (base64), optional
  signerRole         String // BORROWER | STAFF
  signedByBorrowerId String?
  signedByUserId     String? // staff who captured / witnessed
  ipAddress          String?
  signedAt           DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([tenantId, loanId])
}

// ── P1 #10: Collections — promise-to-pay ────────────────────────────────────
enum PtpStatus {
  PENDING
  KEPT
  BROKEN
}

model PromiseToPay {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId          String
  loan            Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(10, 2)
  currency        Currency  @default(USD)
  promisedDate    DateTime
  status          PtpStatus @default(PENDING)
  notes           String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, loanId])
  @@index([tenantId, status, promisedDate])
}
