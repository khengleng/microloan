generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                            String    @id @default(uuid())
  name                          String
  telegramBotToken              String?   @unique // Per-tenant bot token
  plan                          String    @default("FREE") // Basic subscription visibility
  // ACTIVE, SUSPENDED, PENDING_PAYMENT.
  // PENDING_PAYMENT is the self-serve signup gate: the organization exists but
  // no one can authenticate into it until a SUPERADMIN confirms the plan
  // payment. JwtStrategy rejects any non-ACTIVE tenant, so the gate is the
  // same one that enforces suspension.
  status                        String    @default("ACTIVE")
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  // Fix 5: configurable late penalty in $USD per overdue installment per day
  penaltyRatePerDay             Decimal   @default(10.00) @db.Decimal(8, 2)
  // Feature #1: dual-currency — the tenant's reporting/base currency.
  baseCurrency                  Currency  @default(USD)
  // Feature #1: per-tenant interest ceiling (%). Never exceeds NBC cap of 18%.
  maxAnnualInterestRatePct      Decimal   @default(18.00) @db.Decimal(5, 2)
  // Feature #3: require a completed CBC credit check before a loan can be approved.
  requireCreditCheckForApproval Boolean   @default(true)
  // Days a completed credit check stays valid for approval purposes.
  creditCheckValidityDays       Int       @default(90)
  // Fix 9: GDPR soft-delete — set when erasure is requested, hard-delete job runs after 30 days
  deletedAt                     DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  users              User[]
  branches           Branch[]
  borrowers          Borrower[]
  loans              Loan[]
  repayments         Repayment[]
  auditLogs          AuditLog[]
  documents          Document[]
  loanProducts       LoanProduct[]
  exchangeRates      ExchangeRate[]
  ledgerAccounts     LedgerAccount[]
  journalEntries     JournalEntry[]
  provisionRuns      ProvisionRun[]
  creditChecks       CreditCheck[]
  promisesToPay      PromiseToPay[]
  paymentInstruments PaymentInstrument[]
  loanAgreements     LoanAgreement[]
  planPayments       PlanPayment[]

  /// Bumped on any change to roles, assignments, delegations, authorities,
  /// policies or flags, so cached authorization decisions are invalidated.
  authzVersion Int @default(0)

  legalEntities     LegalEntity[]
  portfolios        Portfolio[]
  businessDate      TenantBusinessDate?
  holidayCalendars  HolidayCalendar[]
  accessRoles       AccessRole[]
  accessPolicies    AccessPolicy[]
  flagRules         FlagRule[]
  serviceAccounts   ServiceAccount[]
  workflowVersions  WorkflowVersion[]
  lendingProducts   LendingProduct[]
  borrowerGroups    BorrowerGroup[]
  applications      Application[]
  approvalTasks     ApprovalTask[]
  facilities        Facility[]
  holidayProgrammes PaymentHolidayProgramme[]
  lendingAgreements LendingAgreement[]
  restructureCases  RestructureCase[]
}

/// Plan payment for a self-serve workspace signup.
///
/// A paid plan cannot activate itself: signup mints one of these with a KHQR
/// payload, the tenant sits in PENDING_PAYMENT, and a SUPERADMIN confirms
/// receipt out of band (there is no Bakong settlement API to verify against).
/// `reference` is the unguessable handle the applicant uses to re-open their
/// QR without being able to authenticate yet.
model PlanPayment {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan              String
  amount            Decimal   @db.Decimal(12, 2)
  currency          Currency  @default(USD)
  /// Public, unguessable lookup key shown alongside the QR as the payment memo.
  reference         String    @unique
  /// EMVCo/KHQR payload string. Regenerated on demand; never a credential.
  qrPayload         String
  /// PENDING, CONFIRMED, REJECTED, EXPIRED
  status            String    @default("PENDING")
  confirmedByUserId String?
  confirmedAt       DateTime?
  rejectedReason    String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([status, createdAt])
}

/// The platform operator's own KHQR merchant details, digested from a QR they
/// uploaded. Replaces the KHQR_* environment variables as the source of truth
/// for minting signup payment codes.
///
/// Platform-scoped: it has no tenantId because it does not belong to a tenant,
/// and the Prisma tenant guard denies it to tenant principals outright rather
/// than letting it fall outside the wall by omission. Only one row is ever
/// active — `isActive` lets a replaced QR stay as history for audit.
model PlatformPaymentQr {
  id                   String   @id @default(uuid())
  /// Bakong account id recovered from the uploaded code.
  bakongAccountId      String
  merchantName         String
  merchantCity         String
  merchantCategoryCode String   @default("6012")
  /// The exact payload that was uploaded, kept verbatim for audit and re-parse.
  sourcePayload        String
  /// How it arrived: IMAGE or PAYLOAD.
  sourceType           String
  isActive             Boolean  @default(true)
  uploadedByUserId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, createdAt])
}

/// A subscription tier, defined by the platform owner.
///
/// Tiers were previously a hardcoded union (FREE/BASIC/PROFESSIONAL/ENTERPRISE)
/// with quotas in `plan-limits.ts` and prices in `PLAN_PRICE_*` env vars. They
/// are rows now, so the operator adds, reprices and retires tiers without a
/// deploy.
///
/// Platform-scoped: no tenantId. Deliberately NOT in the Prisma guard's
/// PLATFORM_ONLY set — a tenant principal legitimately reads its own tier's
/// quota ceilings on every quota-checked write, and the catalogue holds no
/// secret. The guard instead classifies it as a platform *catalogue*: readable
/// by tenants, writable only by the platform.
model PlanTier {
  id          String   @id @default(uuid())
  /// Stable key, stored on `Tenant.plan` and `PlanPayment.plan`. Immutable
  /// after creation — renaming would orphan every tenant already on the tier,
  /// since those columns hold the name rather than a foreign key. Rename the
  /// customer-visible `displayName` instead.
  name        String   @unique
  displayName String
  description String?
  priceAmount Decimal  @default(0) @db.Decimal(12, 2)
  currency    Currency @default(USD)

  /// Quota ceilings. NULL means unlimited — chosen over a magic large integer
  /// so "unlimited" survives a round trip through the UI unambiguously, and so
  /// a forgotten field cannot read as a quota of zero.
  maxUsers        Int?
  maxBorrowers    Int?
  maxLoanProducts Int?
  maxLoans        Int?

  /// Display order on the signup page. Ties break by price, then name.
  sortOrder Int @default(0)

  /// Whether the tier can be chosen at signup. A retired tier (false) keeps
  /// serving quota ceilings to tenants already on it — retiring must never
  /// silently demote a paying customer to FREE limits.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum Currency {
  USD
  KHR
}

enum Role {
  SUPERADMIN
  TENANT_ADMIN
  BRANCH_MANAGER
  LOAN_OFFICER
  CREDIT_OFFICER
  APPROVER
  ACCOUNTANT
  AUDITOR
  CUSTOMER_SUPPORT
  BORROWER
  // Legacy roles kept for backward compatibility during migration.
  ADMIN
  OPERATOR
  FINANCE
  SALES
  CX
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  borrowers          Borrower[]
  loans              Loan[]
  paymentInstruments PaymentInstrument[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  email            String    @unique
  // Optional: an account created through a federated provider (Google) has no
  // local password. At least one credential — a password hash or a linked
  // identity — must exist for the account to be usable.
  passwordHash     String?
  twoFactorSecret  String? // For MFA
  twoFactorEnabled Boolean   @default(false)
  isActive         Boolean   @default(true) // For soft delete / suspension
  role             Role      @default(LOAN_OFFICER)
  telegramChatId   String? // Staff's telegram chat ID
  loginAttempts    Int       @default(0) // Brute-force counter
  lockedUntil      DateTime? // Account locked until this timestamp
  lastLoginAt      DateTime? // Last successful login
  lastLoginIp      String? // Last known IP for anomaly detection
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  identities          FederatedIdentity[]
  roleAssignments     RoleAssignment[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([branchId])
  @@index([email])
}

/// A third-party login (currently Google) linked to a staff account.
/// Separate from User so a second provider can be added without a schema
/// change, and so unlinking is a delete rather than a nullable-column dance.
/// Has no tenantId of its own — it is scoped through its owning user.
model FederatedIdentity {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Provider key, e.g. "GOOGLE".
  provider          String
  /// The provider's stable subject id ("sub"), NOT the email — emails change
  /// and are reassignable within a Workspace domain, subjects are not.
  providerAccountId String
  /// Email as asserted by the provider at link time, for display and audit.
  email             String
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Self-service password reset (forgot-password). The raw token is emailed; only
// its hash is stored. Single-use, short-lived.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  // JWT jti (unique per issued refresh token)
  id          String    @id
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Borrower {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstName           String
  lastName            String
  phone               String?
  email               String?
  address             String?
  // Encrypted at rest; exact-match/uniqueness via the deterministic *Hash columns.
  idNumber            String?
  idNumberHash        String?
  phoneHash           String?
  telegramChatId      String?
  // P0 #4: basic KYC capture + manual KYC/AML status (no external screening).
  dateOfBirth         DateTime?
  idType              String? // e.g., NATIONAL_ID, PASSPORT, FAMILY_BOOK
  occupation          String?
  // Risk Batch #7: affordability / debt-service-ratio inputs
  monthlyIncome       Decimal?  @db.Decimal(12, 2)
  monthlyExpenses     Decimal?  @db.Decimal(12, 2)
  kycStatus           KycStatus @default(PENDING)
  kycVerifiedAt       DateTime?
  kycVerifiedByUserId String?
  amlStatus           AmlStatus @default(NOT_SCREENED)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  loans            Loan[]
  creditChecks     CreditCheck[]
  kycDocuments     KycDocument[]
  otps             BorrowerOtp[]
  applications     Application[]
  collateralAssets CollateralAsset[]
  groupMemberships GroupMembership[]

  // Per-tenant uniqueness of national ID via blind index (fixes the former
  // GLOBAL @unique on idNumber, which leaked existence across tenants).
  @@unique([tenantId, idNumberHash])
  @@unique([tenantId, id])
  @@index([tenantId, branchId])
  @@index([phoneHash])
}

// ── CX Batch #6: Borrower self-service portal (phone + OTP auth) ─────────────
// A short-lived one-time code is SMS'd to the borrower's phone. Only the hash
// is stored (sha256 + pepper), single-use, attempt-capped. On success the API
// issues a borrower-scoped JWT (typ=borrower) kept in an HttpOnly cookie.
model BorrowerOtp {
  id         String    @id @default(uuid())
  phone      String
  borrowerId String
  borrower   Borrower  @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  tenantId   String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@index([borrowerId])
}

// ── CX Batch #6: Manual e-KYC — borrower-uploaded identity documents ─────────
// Stored as a base64 data URI or URL (mirrors Document). Staff review flips the
// borrower's aggregate kycStatus; per-document status is advisory.
model KycDocument {
  id         String   @id @default(uuid())
  tenantId   String
  borrowerId String
  borrower   Borrower @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  type       String // e.g. NATIONAL_ID_FRONT, NATIONAL_ID_BACK, SELFIE, PROOF_OF_ADDRESS
  content    String   @db.Text
  mimeType   String?
  createdAt  DateTime @default(now())

  @@index([tenantId, borrowerId])
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AmlStatus {
  NOT_SCREENED
  CLEAR
  FLAGGED
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
  CLOSED
  DEFAULTED
  WRITTEN_OFF
}

enum InterestMethod {
  FLAT
  REDUCING_BALANCE
}

model LoanProduct {
  id                String         @id @default(uuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String // e.g., "Daily Loan", "Weekly Loan", "Mortgage Loan"
  description       String?
  interestMethod    InterestMethod
  currency          Currency       @default(USD)
  isActive          Boolean        @default(true)
  // Fix 5: per-product penalty override (null = use tenant default)
  penaltyRatePerDay Decimal?       @db.Decimal(8, 2)
  // P1 #11: origination fees applied at disbursement (deducted from disbursed cash,
  // recognised as fee income). Processing fee = % of principal; admin fee = flat.
  processingFeePct  Decimal?       @db.Decimal(5, 2)
  adminFee          Decimal?       @db.Decimal(10, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  policies LoanPolicy[]
  loans    Loan[]
}

model LoanPolicy {
  id            String      @id @default(uuid())
  productId     String
  product       LoanProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  creditRating  String // e.g., "A", "B", "C", "EXCELLENT", "GOOD", "FAIR"
  interestRate  Decimal     @db.Decimal(5, 2)
  minTermMonths Int?
  maxTermMonths Int?
  minPrincipal  Decimal?    @db.Decimal(10, 2)
  maxPrincipal  Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Loan {
  id                  String         @id @default(uuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId            String?
  branch              Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  borrowerId          String
  borrower            Borrower       @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  productId           String?
  product             LoanProduct?   @relation(fields: [productId], references: [id], onDelete: Cascade)
  creditRatingApplied String?
  status              LoanStatus     @default(PENDING)
  principal           Decimal        @db.Decimal(10, 2)
  annualInterestRate  Decimal        @db.Decimal(5, 2)
  termMonths          Int
  interestMethod      InterestMethod
  // Feature #1: currency the loan is booked and repaid in.
  currency            Currency       @default(USD)
  // Feature #1: FX rate (loan currency -> tenant base currency) captured at
  // disbursement, so historical portfolio value in base currency is stable.
  fxRateToBase        Decimal?       @db.Decimal(18, 8)
  // P1 #11: origination fee charged at disbursement (snapshot).
  feeCharged          Decimal        @default(0) @db.Decimal(10, 2)
  startDate           DateTime
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  schedules         RepaymentSchedule[]
  repayments        Repayment[]
  documents         Document[]
  collaterals       Collateral[]
  guarantors        Guarantor[]
  interactions      LoanInteraction[]
  provisions        LoanProvision[]
  journalEntries    JournalEntry[]
  promisesToPay     PromiseToPay[]
  agreements        LoanAgreement[]
  createdByUserId   String?
  reviewedByUserId  String?
  disbursedByUserId String?

  // Approval Workflow Fields
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?

  // P1 #9: write-off audit trail
  writtenOffAt       DateTime?
  writtenOffByUserId String?
  writeOffReason     String?

  // Risk Batch #7: restructuring / rescheduling
  isRestructured   Boolean   @default(false)
  restructuredAt   DateTime?
  restructureCount Int       @default(0)

  creditScores CreditScore[]
  restructures LoanRestructure[]

  @@index([tenantId, branchId])
}

// ── Risk Batch #7: internal scorecard result (persisted, explainable) ───────
model CreditScore {
  id              String   @id @default(uuid())
  tenantId        String
  loanId          String
  loan            Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  borrowerId      String
  score           Int
  grade           String
  decision        String // APPROVE | REFER | DECLINE
  dsr             Decimal? @db.Decimal(6, 4)
  recommendedRate Decimal? @db.Decimal(5, 2)
  factors         Json
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([tenantId, loanId])
}

// ── Risk Batch #7: loan restructuring / rescheduling audit ──────────────────
model LoanRestructure {
  id                    String   @id @default(uuid())
  tenantId              String
  loanId                String
  loan                  Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  reason                String
  oldTermMonths         Int
  oldAnnualInterestRate Decimal  @db.Decimal(5, 2)
  oldOutstanding        Decimal  @db.Decimal(12, 2)
  newTermMonths         Int
  newAnnualInterestRate Decimal  @db.Decimal(5, 2)
  createdByUserId       String?
  createdAt             DateTime @default(now())

  @@index([tenantId, loanId])
}

model Collateral {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  type        String // e.g., "LAND_TITLE", "VEHICLE", "GOLD", "OTHER"
  description String
  value       Decimal  @db.Decimal(10, 2)
  idNumber    String? // e.g., Land title number or license plate
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guarantor {
  id        String   @id @default(uuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  idNumber  String?
  relation  String? // e.g., "SPOUSE", "PARENT", "COLLEAGUE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanInteraction {
  id        String   @id @default(uuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  userId    String
  title     String? // e.g., "Follow-up Call", "Home Visit"
  notes     String
  type      String   @default("NOTE") // NOTE, CALL, VISIT, SYSTEM
  createdAt DateTime @default(now())
}

model RepaymentSchedule {
  id                   String    @id @default(uuid())
  loanId               String
  loan                 Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  installmentNumber    Int
  dueDate              DateTime
  principalAmount      Decimal   @db.Decimal(10, 2)
  interestAmount       Decimal   @db.Decimal(10, 2)
  penaltyAmount        Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal   @db.Decimal(10, 2)
  outstandingPrincipal Decimal   @db.Decimal(10, 2)
  paidPrincipal        Decimal   @default(0) @db.Decimal(10, 2)
  paidInterest         Decimal   @default(0) @db.Decimal(10, 2)
  paidPenalty          Decimal   @default(0) @db.Decimal(10, 2)
  isPaid               Boolean   @default(false)
  penaltyLastAppliedAt DateTime? // Guard: ensures penalty is applied at most once per day
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Repayment {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId           String
  loan             Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(10, 2)
  currency         Currency  @default(USD)
  principalPaid    Decimal   @default(0) @db.Decimal(10, 2)
  interestPaid     Decimal   @default(0) @db.Decimal(10, 2)
  penaltyPaid      Decimal   @default(0) @db.Decimal(10, 2)
  date             DateTime  @default(now())
  // P0 #2: client-supplied dedupe key — a retried/double-submitted repayment with
  // the same key returns the original instead of posting twice. NULLs are allowed
  // and treated as distinct by Postgres, so keyless posts are unaffected.
  idempotencyKey   String?
  // P1 #13: reversal audit trail (a reversed repayment is excluded from balances).
  reversedAt       DateTime?
  reversedByUserId String?
  reversalReason   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String? // Nullable  — allows anonymous security events (e.g. unknown email login)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // CREATE, UPDATE, DELETE, LOGIN
  entity    String // Borrower, Loan, Repayment, User, Tenant
  entityId  String
  metadata  Json? // Masked metadata only — never raw PII
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([userId])
}

model Document {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  name      String
  content   String   @db.Text // Base64 content or public URL
  type      String // e.g., "application/pdf", "image/png", or "url"
  createdAt DateTime @default(now())
}

// ── Feature #1: Multi-currency FX rates ─────────────────────────────────────
// Tenant-scoped exchange rates. `rate` = units of `toCurrency` per 1 unit of
// `fromCurrency`. Rates are effective-dated; the latest effective rate at or
// before a transaction date is used.
model ExchangeRate {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency  Currency
  toCurrency    Currency
  rate          Decimal  @db.Decimal(18, 8)
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  @@index([tenantId, fromCurrency, toCurrency, effectiveDate])
}

// ── Feature #3: General Ledger (double-entry) ───────────────────────────────
enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSource {
  DISBURSEMENT
  REPAYMENT
  PENALTY
  PROVISION
  WRITEOFF
  MANUAL
}

model LedgerAccount {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String // e.g., "1000" cash, "1200" loans receivable
  name      String
  type      LedgerAccountType
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  lines        JournalLine[]
  lendingLines LendingJournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model JournalEntry {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date            DateTime      @default(now())
  source          JournalSource
  currency        Currency      @default(USD)
  description     String
  // Optional linkage to the business object that produced this entry.
  loanId          String?
  loan            Loan?         @relation(fields: [loanId], references: [id], onDelete: SetNull)
  referenceId     String? // repaymentId, provisionRunId, etc.
  createdByUserId String?
  createdAt       DateTime      @default(now())

  lines JournalLine[]

  @@index([tenantId, date])
  @@index([tenantId, source])
  @@index([loanId])
}

model JournalLine {
  id        String        @id @default(uuid())
  entryId   String
  entry     JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId String
  account   LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit     Decimal       @default(0) @db.Decimal(18, 2)
  credit    Decimal       @default(0) @db.Decimal(18, 2)

  @@index([entryId])
  @@index([accountId])
}

// ── Feature #3: Loan-loss provisioning (NBC classification) ─────────────────
enum LoanClassification {
  STANDARD
  SPECIAL_MENTION
  SUBSTANDARD
  DOUBTFUL
  LOSS
}

model ProvisionRun {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runDate         DateTime @default(now())
  totalProvision  Decimal  @default(0) @db.Decimal(18, 2)
  loanCount       Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())

  provisions LoanProvision[]

  @@index([tenantId, runDate])
}

model LoanProvision {
  id                   String             @id @default(uuid())
  runId                String
  run                  ProvisionRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  loanId               String
  loan                 Loan               @relation(fields: [loanId], references: [id], onDelete: Cascade)
  daysOverdue          Int
  classification       LoanClassification
  outstandingPrincipal Decimal            @db.Decimal(18, 2)
  provisionRate        Decimal            @db.Decimal(6, 4)
  provisionAmount      Decimal            @db.Decimal(18, 2)
  currency             Currency           @default(USD)

  @@index([runId])
  @@index([loanId])
}

// ── Feature #3: Credit Bureau Cambodia (CBC) checks ─────────────────────────
enum CreditCheckStatus {
  PENDING
  COMPLETED
  FAILED
}

model CreditCheck {
  id                String            @id @default(uuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  borrowerId        String
  borrower          Borrower          @relation(fields: [borrowerId], references: [id], onDelete: Cascade)
  provider          String            @default("CBC")
  status            CreditCheckStatus @default(PENDING)
  score             Int? // bureau score (nullable until completed)
  grade             String? // e.g., "A".."E"
  reportRef         String? // bureau reference id
  summary           String? // human-readable summary (no raw PII)
  requestedByUserId String?
  createdAt         DateTime          @default(now())
  completedAt       DateTime?

  @@index([tenantId, borrowerId])
}

// ── Payments Batch #P1: Static-QR payment rail (display-only) ────────────────
// A tenant (optionally per-branch) stores its static collection QR — either the
// KHQR/EMVCo payload string (rendered to an image on demand) or an uploaded QR
// image (base64/URL). Disbursement stays manual and repayments are still posted
// by an officer; the QR is a payer convenience shown on loans, receipts and the
// borrower portal. `resolveForLoan` prefers a branch instrument, else the tenant
// default.
model PaymentInstrument {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  label         String // e.g. "ABA Main", "Bakong - HQ"
  bankName      String?
  accountName   String?
  accountNumber String?
  // KHQR / EMVCo static payload string. When present it is rendered to a QR
  // image server-side (qrcode lib). Never contains an amount for a static QR.
  qrPayload     String?  @db.Text
  // Fallback: an uploaded QR image (base64 data URI or public URL) when only an
  // image is available and no payload string can be provided.
  qrImage       String?  @db.Text
  currency      Currency @default(USD)
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId, branchId])
}

// ── Compliance Batch #4: Key Facts Statement + e-signature ──────────────────
// An immutable, hash-anchored record that a borrower (or staff on their behalf)
// was shown the Key Facts (principal, nominal rate, EIR/APR, total cost of
// credit) and signed the loan agreement. keyFacts is the snapshot at signing;
// agreementHash binds the exact disclosed terms so tampering is detectable.
model LoanAgreement {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  version            Int      @default(1)
  keyFacts           Json // Key Facts snapshot (EIR, totals) at signing
  agreementHash      String // sha256 over canonical disclosed terms
  signatureName      String? // typed signer name
  signatureImage     String?  @db.Text // drawn signature (base64), optional
  signerRole         String // BORROWER | STAFF
  signedByBorrowerId String?
  signedByUserId     String? // staff who captured / witnessed
  ipAddress          String?
  signedAt           DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([tenantId, loanId])
}

// ── P1 #10: Collections — promise-to-pay ────────────────────────────────────
enum PtpStatus {
  PENDING
  KEPT
  BROKEN
}

model PromiseToPay {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loanId          String
  loan            Loan      @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(10, 2)
  currency        Currency  @default(USD)
  promisedDate    DateTime
  status          PtpStatus @default(PENDING)
  notes           String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, loanId])
  @@index([tenantId, status, promisedDate])
}

// ═══════════════════════════════════════════════════════════════════════════
// Configurable lending platform (Phase 1)
//
// Conventions:
//  • Money is Decimal(24,4) with an explicit ISO currency code (text). The
//    engine enforces each currency's minor units; the column is wide enough
//    for 0–4 decimal currencies.
//  • Rates are decimal fractions in Decimal(18,10) (0.12 = 12%).
//  • Business dates are @db.Date. Instants are timestamptz.
//  • Children reference parents by (tenantId, id), so the database itself
//    rejects a cross-tenant reference — not only the application.
//  • Financial and audit rows are immutable (triggers in the migration);
//    corrections are reversal events.
// ═══════════════════════════════════════════════════════════════════════════

// ── Platform catalogue (no tenant) ─────────────────────────────────────────

/// A business classification of loans. Platform catalogue.
model LoanFamily {
  code        String @id
  name        String
  description String
  sortOrder   Int    @default(0)

  templates ProductTemplate[]
}

/// Reusable starting configuration for a product. Platform catalogue.
model ProductTemplate {
  code              String     @id
  familyCode        String
  family            LoanFamily @relation(fields: [familyCode], references: [code])
  name              String
  description       String
  defaultConfig     Json
  /// Capabilities the product type needs beyond those its configuration implies.
  extraCapabilities String[]
  phase1Slice       Boolean    @default(false)
  updatedAt         DateTime   @updatedAt
}

/// Action-based permission, e.g. "credit_decision.approve". Platform catalogue.
model AccessPermission {
  code            String  @id
  description     String
  category        String
  /// Moves money or changes a financial record.
  financial       Boolean @default(false)
  /// May be held by a platform administrator. Tenant-data actions never are.
  platformAllowed Boolean @default(false)

  roles RolePermission[]
}

/// Feature flag definition. Platform catalogue.
model FeatureFlag {
  key            String  @id
  description    String
  category       String
  /// Sensitive flags gate mutations; a missing or invalid rule fails closed.
  sensitive      Boolean @default(false)
  defaultEnabled Boolean @default(false)

  platformRules PlatformFlagRule[]
  tenantRules   FlagRule[]
}

/// Platform-level flag rule (including emergency-off). Platform catalogue:
/// readable by tenants for evaluation, writable only by the platform.
model PlatformFlagRule {
  id            String      @id @default(uuid())
  flagKey       String
  flag          FeatureFlag @relation(fields: [flagKey], references: [key])
  enabled       Boolean
  /// Emergency-off: overrides every tenant and narrower rule.
  emergency     Boolean     @default(false)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  /// PENDING_APPROVAL, ACTIVE, REJECTED, SUPERSEDED
  status        String      @default("PENDING_APPROVAL")
  reason        String
  makerId       String
  checkerId     String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([flagKey, status])
}

// ── Organisation structure ─────────────────────────────────────────────────

model LegalEntity {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  country   String   @default("KH")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// A loan officer's book of loans. Role assignments can be scoped to portfolios.
model Portfolio {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  branchId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// The tenant's current business date. Postings carry it; backdating is limited by product configuration.
model TenantBusinessDate {
  tenantId     String   @id
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessDate DateTime @db.Date
  updatedBy    String?
  updatedAt    DateTime @updatedAt
}

model HolidayCalendar {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  /// ISO days of week that are not business days (6 = Saturday, 7 = Sunday).
  weekendDays Int[]
  createdAt   DateTime  @default(now())
  holidays    Holiday[]

  @@unique([tenantId, code])
}

model Holiday {
  id         String          @id @default(uuid())
  calendarId String
  calendar   HolidayCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime        @db.Date
  name       String

  @@unique([calendarId, date])
}

// ── Access control ─────────────────────────────────────────────────────────

model AccessRole {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String   @default("")
  /// Seeded from the platform role definitions; permissions are maintained by release.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  assignments RoleAssignment[]
  authorities ApprovalAuthority[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

model RolePermission {
  roleId         String
  role           AccessRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionCode String
  permission     AccessPermission @relation(fields: [permissionCode], references: [code])

  @@id([roleId, permissionCode])
}

/// A user's role, scoped to branches / portfolios / legal entities, with validity dates.
/// Sensitive roles require a second administrator to approve (status PENDING → ACTIVE).
model RoleAssignment {
  id             String     @id @default(uuid())
  tenantId       String
  userId         String
  user           User       @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  roleId         String
  role           AccessRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  allBranches    Boolean    @default(false)
  branchIds      String[]
  portfolioIds   String[]
  legalEntityIds String[]
  validFrom      DateTime   @default(now())
  validTo        DateTime?
  /// PENDING, ACTIVE, REJECTED, REVOKED
  status         String     @default("PENDING")
  requestedBy    String
  approvedBy     String?
  revokedBy      String?
  revokedAt      DateTime?
  reason         String     @default("")
  createdAt      DateTime   @default(now())

  @@index([tenantId, userId, status])
}

/// Temporary delegation of specific permissions (and optionally authority) between users.
model Delegation {
  id          String    @id @default(uuid())
  tenantId    String
  fromUserId  String
  toUserId    String
  permissions String[]
  maxAmount   Decimal?  @db.Decimal(24, 4)
  currency    String?
  validFrom   DateTime
  validTo     DateTime
  /// PENDING, ACTIVE, REJECTED, REVOKED
  status      String    @default("PENDING")
  reason      String
  createdBy   String
  approvedBy  String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, toUserId, status])
}

/// Maximum amount a role or user may approve for a permission, per currency.
model ApprovalAuthority {
  id          String      @id @default(uuid())
  tenantId    String
  roleId      String?
  role        AccessRole? @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  userId      String?
  permission  String
  currency    String
  maxAmount   Decimal     @db.Decimal(24, 4)
  familyCode  String?
  validFrom   DateTime    @default(now())
  validTo     DateTime?
  /// PENDING, ACTIVE, REJECTED, REVOKED
  status      String      @default("PENDING")
  requestedBy String
  approvedBy  String?
  createdAt   DateTime    @default(now())

  @@index([tenantId, permission, status])
}

model AccessPolicy {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String          @default("")
  createdAt   DateTime        @default(now())
  versions    PolicyVersion[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// Versioned ABAC rules in the constrained policy schema. Maker-checker governed.
model PolicyVersion {
  id              String       @id @default(uuid())
  tenantId        String
  policyId        String
  policy          AccessPolicy @relation(fields: [tenantId, policyId], references: [tenantId, id], onDelete: Cascade)
  version         Int
  rules           Json
  /// DRAFT, SUBMITTED, ACTIVE, REJECTED, RETIRED
  status          String       @default("DRAFT")
  makerId         String
  checkerId       String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  rejectionReason String?
  createdAt       DateTime     @default(now())

  @@unique([policyId, version])
  @@index([tenantId, status])
}

/// Tenant-scoped flag rule. Becomes ACTIVE only through FlagChangeApproval.
model FlagRule {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flagKey       String
  flag          FeatureFlag @relation(fields: [flagKey], references: [key])
  /// TENANT, PRODUCT, BRANCH, CHANNEL, SEGMENT, COHORT
  scopeType     String
  scopeValue    String?
  enabled       Boolean
  /// Tenant emergency-off: cannot be overridden by narrower tenant rules.
  emergency     Boolean     @default(false)
  priority      Int         @default(100)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  /// PENDING_APPROVAL, ACTIVE, REJECTED, SUPERSEDED
  status        String      @default("PENDING_APPROVAL")
  createdAt     DateTime    @default(now())

  approvals FlagChangeApproval[]

  @@index([tenantId, flagKey, status])
}

model FlagChangeApproval {
  id        String    @id @default(uuid())
  tenantId  String
  ruleId    String
  rule      FlagRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// ACTIVATE or DEACTIVATE
  action    String
  reason    String
  makerId   String
  checkerId String?
  /// PENDING, APPROVED, REJECTED
  status    String    @default("PENDING")
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, status])
}

/// Stable, explicit pilot cohort membership. Never random per request.
model CohortMembership {
  id          String   @id @default(uuid())
  tenantId    String
  cohortCode  String
  /// BRANCH, USER, BORROWER
  subjectType String
  subjectId   String
  addedBy     String
  createdAt   DateTime @default(now())

  @@unique([tenantId, cohortCode, subjectType, subjectId])
}

/// Integration principal with narrow scopes and a tenant binding.
model ServiceAccount {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String    @unique
  keyHash    String
  scopes     String[]
  /// ACTIVE, DISABLED
  status     String    @default("ACTIVE")
  expiresAt  DateTime
  createdBy  String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

// ── Products ───────────────────────────────────────────────────────────────

model WorkflowVersion {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String
  version    Int
  name       String
  definition Json
  /// DRAFT, SUBMITTED, ACTIVE, REJECTED, RETIRED
  status     String    @default("DRAFT")
  makerId    String
  checkerId  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tenantId, code, version])
}

model LendingProduct {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  familyCode   String
  templateCode String
  name         String
  createdBy    String
  createdAt    DateTime         @default(now())
  versions     ProductVersion[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// Approved versions are immutable (enforced by trigger); edits create a new version.
model ProductVersion {
  id                   String         @id @default(uuid())
  tenantId             String
  productId            String
  product              LendingProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  version              Int
  /// DRAFT, SUBMITTED, APPROVED, ACTIVE, RETIRED, REJECTED
  status               String         @default("DRAFT")
  config               Json
  configHash           String
  requiredCapabilities String[]
  engineVersion        String
  effectiveFrom        DateTime?      @db.Date
  effectiveTo          DateTime?      @db.Date
  changeSummary        String         @default("")
  makerId              String
  submittedAt          DateTime?
  checkerId            String?
  approvedAt           DateTime?
  activatedBy          String?
  activatedAt          DateTime?
  retiredAt            DateTime?
  rejectionReason      String?
  createdAt            DateTime       @default(now())

  pricing   PricingConfiguration?
  repayment RepaymentConfiguration?

  @@unique([productId, version])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model PricingConfiguration {
  id                String         @id @default(uuid())
  tenantId          String
  productVersionId  String
  productVersion    ProductVersion @relation(fields: [tenantId, productVersionId], references: [tenantId, id], onDelete: Cascade)
  rateType          String
  interestMethod    String
  rateConvention    String
  accrualBasis      String
  dayCount          String
  defaultAnnualRate Decimal?       @db.Decimal(18, 10)
  payload           Json

  @@unique([tenantId, productVersionId])
}

model RepaymentConfiguration {
  id               String         @id @default(uuid())
  tenantId         String
  productVersionId String
  productVersion   ProductVersion @relation(fields: [tenantId, productVersionId], references: [tenantId, id], onDelete: Cascade)
  method           String
  frequency        String?
  payload          Json

  @@unique([tenantId, productVersionId])
}

/// Benchmark rate history for floating pricing (auditable resets).
model RateObservation {
  id              String   @id @default(uuid())
  tenantId        String
  benchmarkCode   String
  observationDate DateTime @db.Date
  rate            Decimal  @db.Decimal(18, 10)
  source          String
  recordedBy      String
  createdAt       DateTime @default(now())

  @@unique([tenantId, benchmarkCode, observationDate])
}

// ── Borrower groups (Phase 2 behaviour; structure in place) ─────────────────

/// A solidarity group: borrowers who meet together and, under GROUP_JOINT
/// products, are each liable for the whole of the group's loan.
model BorrowerGroup {
  id        String            @id @default(uuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId  String?
  code      String
  name      String
  /// FORMING, ACTIVE, DORMANT, DISBANDED
  status    String            @default("FORMING")
  /// The date the group was formed, which member tenure is measured from.
  formedOn  DateTime?         @db.Date
  /// Optimistic concurrency token; membership changes bump it.
  version   Int               @default(0)
  createdBy String?
  createdAt DateTime          @default(now())
  updatedAt DateTime?         @updatedAt
  members   GroupMembership[]
  loans     LoanGroupMember[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model GroupMembership {
  id         String        @id @default(uuid())
  tenantId   String
  groupId    String
  group      BorrowerGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  borrowerId String
  borrower   Borrower      @relation(fields: [tenantId, borrowerId], references: [tenantId, id], onDelete: Cascade)
  /// LEADER, MEMBER
  role       String        @default("MEMBER")
  /// Business date the member joined; tenure is measured from it.
  joinedOn   DateTime?     @db.Date
  joinedAt   DateTime      @default(now())
  /// Business date the member left, if they have.
  leftOn     DateTime?     @db.Date
  leftAt     DateTime?
  exitReason String?
  /// What the member settled on leaving while a loan was outstanding.
  exitSettlement Decimal?  @db.Decimal(24, 4)

  @@unique([groupId, borrowerId])
  @@unique([tenantId, id])
  @@index([tenantId, borrowerId])
}

/// A member bound to a specific group loan, with the share they agreed to
/// carry and what they can actually be pursued for.
///
/// Under GROUP_JOINT `liableFor` is the whole principal, not the share: that
/// difference is the entire legal point of a solidarity group, so it is
/// stored rather than recomputed from a flag at read time. Append-only — the
/// binding is part of the contract.
model LoanGroupMember {
  id            String        @id @default(uuid())
  tenantId      String
  loanAccountId String
  groupId       String
  group         BorrowerGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  borrowerId    String
  /// LEADER, MEMBER
  role          String        @default("MEMBER")
  /// GROUP_JOINT, GROUP_INDIVIDUAL
  liability     String
  /// The member's agreed portion of the principal.
  shareAmount   Decimal       @db.Decimal(24, 4)
  /// That portion as a decimal fraction.
  shareFraction Decimal       @db.Decimal(18, 10)
  /// What this member can be pursued for at booking.
  liableFor     Decimal       @db.Decimal(24, 4)
  createdAt     DateTime      @default(now())

  @@unique([loanAccountId, borrowerId])
  @@unique([tenantId, id])
  @@index([tenantId, loanAccountId])
  @@index([tenantId, borrowerId])
}

/// Who actually paid, within a repayment on a group loan.
///
/// The loan is settled by the group as a whole, so this never changes what
/// the loan owes; it records the internal position the group meeting and the
/// field officer work from. Append-only.
model GroupContribution {
  id               String   @id @default(uuid())
  tenantId         String
  loanAccountId    String
  financialEventId String
  borrowerId       String
  amount           Decimal  @db.Decimal(24, 4)
  createdAt        DateTime @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, loanAccountId])
  @@index([tenantId, financialEventId])
}

// ── Origination ────────────────────────────────────────────────────────────

model Application {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference        String
  branchId         String
  portfolioId      String?
  legalEntityId    String?
  /// For a group loan this is the group's leader, who signs for it.
  borrowerId       String
  borrower         Borrower  @relation(fields: [tenantId, borrowerId], references: [tenantId, id], onDelete: Cascade)
  /// Set when the product carries group liability; null for individual loans.
  groupId          String?
  /// Set when this application refinances an existing loan, which its
  /// proceeds will settle at disbursement.
  refinancesLoanId String?
  productId        String
  /// Pinned when the application is created; terms are checked against it.
  productVersionId String
  channel          String
  segmentCode      String?
  /// DRAFT, SUBMITTED, RECOMMENDED, APPROVED, REJECTED, WITHDRAWN, BOOKED
  status           String    @default("DRAFT")
  currency         String
  requestedAmount  Decimal   @db.Decimal(24, 4)
  terms            Json
  purpose          String    @default("")
  createdBy        String
  submittedAt      DateTime?
  decidedAt        DateTime?
  version          Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  documents  ApplicationDocument[]
  decisions  CreditDecision[]
  conditions ConditionPrecedent[]
  guarantees Guarantee[]
  pledges    CollateralPledge[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, groupId])
}

model ApplicationDocument {
  id              String      @id @default(uuid())
  tenantId        String
  applicationId   String
  application     Application @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  code            String
  fileName        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  storageProvider String
  storageKey      String
  uploadedBy      String
  createdAt       DateTime    @default(now())

  @@index([tenantId, applicationId])
}

/// Immutable credit decision history.
model CreditDecision {
  id             String      @id @default(uuid())
  tenantId       String
  applicationId  String
  application    Application @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  /// RECOMMEND, APPROVE, REJECT
  type           String
  decidedBy      String
  amount         Decimal     @db.Decimal(24, 4)
  currency       String
  terms          Json
  rationale      String
  assessment     Json
  policyDecision Json
  createdAt      DateTime    @default(now())

  @@index([tenantId, applicationId])
}

/// A pending maker-checker step for any subject (application, disbursement, write-off, product version…).
model ApprovalTask {
  id                 String    @id @default(uuid())
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subjectType        String
  subjectId          String
  action             String
  requiredPermission String
  amount             Decimal?  @db.Decimal(24, 4)
  currency           String?
  payload            Json      @default("{}")
  /// PENDING, APPROVED, REJECTED, CANCELLED, EXECUTED
  status             String    @default("PENDING")
  makerId            String
  decidedBy          String?
  decidedAt          DateTime?
  comment            String?
  createdAt          DateTime  @default(now())

  @@index([tenantId, status, subjectType])
  @@index([tenantId, subjectType, subjectId])
}

model ConditionPrecedent {
  id            String      @id @default(uuid())
  tenantId      String
  applicationId String
  application   Application @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  code          String
  label         String
  /// OUTSTANDING, SATISFIED, WAIVED
  status        String      @default("OUTSTANDING")
  evidence      String?
  resolvedBy    String?
  resolvedAt    DateTime?

  @@unique([applicationId, code])
}

model CollateralAsset {
  id          String             @id @default(uuid())
  tenantId    String
  borrowerId  String
  borrower    Borrower           @relation(fields: [tenantId, borrowerId], references: [tenantId, id], onDelete: Cascade)
  type        String
  description String
  currency    String
  createdBy   String
  createdAt   DateTime           @default(now())
  valuations  Valuation[]
  pledges     CollateralPledge[]

  @@unique([tenantId, id])
}

model Valuation {
  id            String          @id @default(uuid())
  tenantId      String
  collateralId  String
  collateral    CollateralAsset @relation(fields: [tenantId, collateralId], references: [tenantId, id], onDelete: Cascade)
  valuationDate DateTime        @db.Date
  marketValue   Decimal         @db.Decimal(24, 4)
  valuer        String
  method        String
  recordedBy    String
  createdAt     DateTime        @default(now())

  @@index([tenantId, collateralId])
}

model CollateralPledge {
  id            String          @id @default(uuid())
  tenantId      String
  collateralId  String
  collateral    CollateralAsset @relation(fields: [tenantId, collateralId], references: [tenantId, id], onDelete: Cascade)
  applicationId String
  application   Application     @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  /// ACTIVE, RELEASED
  status        String          @default("ACTIVE")
  createdAt     DateTime        @default(now())

  @@unique([collateralId, applicationId])
}

model Guarantee {
  id                  String      @id @default(uuid())
  tenantId            String
  applicationId       String
  application         Application @relation(fields: [tenantId, applicationId], references: [tenantId, id], onDelete: Cascade)
  guarantorName       String
  guarantorBorrowerId String?
  /// PERSONAL, CORPORATE
  type                String
  amount              Decimal     @db.Decimal(24, 4)
  currency            String
  createdBy           String
  createdAt           DateTime    @default(now())

  @@index([tenantId, applicationId])
}

// ── Facilities (Phase 2 behaviour; structure in place) ──────────────────────

/// A limit the borrower draws against, rather than a principal disbursed once.
///
/// The drawn balance, its accrual, repayments, delinquency and journals all
/// live on the facility's `LoanAccount`, exactly as for a term loan — there is
/// one servicing path. This model owns only what a limit adds: the committed
/// amount, the availability window, drawdown governance and the tranche plan.
model Facility {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference        String
  borrowerId       String
  branchId         String
  portfolioId      String?
  legalEntityId    String?
  productId        String
  productVersionId String
  familyCode       String
  /// REVOLVING, OVERDRAFT, STAGED_DRAWDOWN
  facilityType     String
  currency         String
  /// The agreement (and so the loan account) carrying the drawn balance.
  agreementId      String   @unique
  /// REVOLVING / OVERDRAFT reinstate the limit on repayment; STAGED_DRAWDOWN does not.
  limitReinstates  Boolean
  limitAmount      Decimal  @db.Decimal(24, 4)
  availabilityFrom DateTime @db.Date
  availabilityTo   DateTime @db.Date
  maturityDate     DateTime @db.Date
  /// PENDING, ACTIVE, SUSPENDED, EXPIRED, TERMED_OUT, CLOSED, CANCELLED
  status           String   @default("PENDING")
  /// Cumulative amount ever advanced; never reduced by repayment.
  totalDrawn       Decimal  @default(0) @db.Decimal(24, 4)
  /// Interest and fees charged to the facility since inception.
  chargesRaised    Decimal  @default(0) @db.Decimal(24, 4)
  lastAccrualDate  DateTime? @db.Date
  lastStatementTo  DateTime? @db.Date
  suspendedAt      DateTime?
  suspendedReason  String?
  termedOutAt      DateTime?
  closedAt         DateTime?
  /// Optimistic concurrency token; every drawdown or limit change bumps it.
  version          Int      @default(0)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  drawdowns   Drawdown[]
  conditions  FacilityCondition[]
  statements  FacilityStatement[]
  limitEvents FacilityLimitChange[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@unique([tenantId, agreementId])
  @@index([tenantId, status])
  @@index([tenantId, borrowerId])
  @@index([tenantId, branchId])
}

/// A request to release money against a facility, under maker-checker.
///
/// REQUESTED → APPROVED → RELEASED, or REJECTED / CANCELLED. Releasing posts a
/// DISBURSEMENT financial event on the facility's loan account; `eventId` is
/// the link, and it is set exactly once.
model Drawdown {
  id             String   @id @default(uuid())
  tenantId       String
  facilityId     String
  facility       Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  sequence       Int
  amount         Decimal  @db.Decimal(24, 4)
  currency       String
  valueDate      DateTime @db.Date
  /// STAGED_DRAWDOWN: the tranche this releases. Null for the other types.
  trancheCode    String?
  purpose        String   @default("")
  /// REQUESTED, APPROVED, RELEASED, REJECTED, CANCELLED
  status         String   @default("REQUESTED")
  /// The posted disbursement, once released.
  eventId        String?  @unique
  requestedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  releasedBy     String?
  releasedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectionReason String?
  idempotencyKey String?
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([facilityId, sequence])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, facilityId, status])
}

/// A condition gating a staged tranche. Satisfying one is evidence-backed;
/// waiving one is a credit concession and is recorded as such.
model FacilityCondition {
  id          String    @id @default(uuid())
  tenantId    String
  facilityId  String
  facility    Facility  @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  trancheCode String
  code        String
  label       String
  /// PENDING, SATISFIED, WAIVED
  status      String    @default("PENDING")
  evidence    String?
  satisfiedBy String?
  satisfiedAt DateTime?
  waivedBy    String?
  waivedAt    DateTime?
  waiverReason String?
  createdAt   DateTime  @default(now())

  @@unique([facilityId, trancheCode, code])
  @@unique([tenantId, id])
  @@index([tenantId, facilityId])
}

/// A period statement: what moved, what was charged and what is now due.
/// Append-only — a correction is a later statement, never an edit.
model FacilityStatement {
  id                String   @id @default(uuid())
  tenantId          String
  facilityId        String
  facility          Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  sequence          Int
  periodStart       DateTime @db.Date
  /// Exclusive.
  periodEnd         DateTime @db.Date
  openingBalance    Decimal  @db.Decimal(24, 4)
  drawdowns         Decimal  @db.Decimal(24, 4)
  repayments        Decimal  @db.Decimal(24, 4)
  interest          Decimal  @db.Decimal(24, 4)
  overlimitInterest Decimal  @default(0) @db.Decimal(24, 4)
  commitmentFee     Decimal  @default(0) @db.Decimal(24, 4)
  closingBalance    Decimal  @db.Decimal(24, 4)
  chargesRaised     Decimal  @db.Decimal(24, 4)
  minimumPayment    Decimal? @db.Decimal(24, 4)
  minimumPaymentDue DateTime? @db.Date
  /// Engine inputs and the computed breakdown, for audit.
  calculation       Json
  engineVersion     String
  createdBy         String
  createdAt         DateTime @default(now())

  @@unique([facilityId, sequence])
  @@unique([tenantId, id])
  @@index([tenantId, facilityId, periodEnd])
}

/// A change to the committed limit, under maker-checker. Append-only: the
/// facility's current limit is the latest APPROVED row applied to it.
model FacilityLimitChange {
  id             String   @id @default(uuid())
  tenantId       String
  facilityId     String
  facility       Facility @relation(fields: [tenantId, facilityId], references: [tenantId, id], onDelete: Cascade)
  previousLimit  Decimal  @db.Decimal(24, 4)
  newLimit       Decimal  @db.Decimal(24, 4)
  /// INCREASE, DECREASE, EXTENSION, SUSPENSION, REINSTATEMENT
  changeType     String
  reason         String
  effectiveDate  DateTime @db.Date
  /// REQUESTED, APPROVED, REJECTED
  status         String   @default("REQUESTED")
  requestedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  createdAt      DateTime @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, facilityId, createdAt])
}

// ── Agreements and accounts ────────────────────────────────────────────────

/// The booked contract (spec "LoanAgreement"; that name is taken by the
/// existing key-facts signature record). Terms live in AgreementVersion.
model LendingAgreement {
  id               String             @id @default(uuid())
  tenantId         String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference        String
  applicationId    String             @unique
  borrowerId       String
  productId        String
  productVersionId String
  currency         String
  currentVersion   Int                @default(1)
  createdBy        String
  createdAt        DateTime           @default(now())
  versions         AgreementVersion[]
  account          LoanAccount?

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
}

/// Immutable snapshot of product configuration + negotiated terms + engine input.
model AgreementVersion {
  id            String           @id @default(uuid())
  tenantId      String
  agreementId   String
  agreement     LendingAgreement @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Cascade)
  version       Int
  /// BOOKING, DISBURSEMENT_DATE, PREPAYMENT_RECAST, PREPAYMENT_SHORTEN, RATE_RESET, RESTRUCTURE
  reason        String
  productConfig Json
  configHash    String
  terms         Json
  scheduleInput Json
  calculation   Json
  engineVersion String
  effectiveDate DateTime         @db.Date
  createdBy     String
  createdAt     DateTime         @default(now())

  @@unique([agreementId, version])
}

model LoanAccount {
  id                     String           @id @default(uuid())
  tenantId               String
  reference              String
  agreementId            String           @unique
  agreement              LendingAgreement @relation(fields: [tenantId, agreementId], references: [tenantId, id], onDelete: Cascade)
  applicationId          String
  borrowerId             String
  branchId               String
  portfolioId            String?
  legalEntityId          String?
  productId              String
  productVersionId       String
  familyCode             String
  currency               String
  /// BOOKED, ACTIVE, CLOSED, WRITTEN_OFF
  status                 String           @default("BOOKED")
  bookedPrincipal        Decimal          @db.Decimal(24, 4)
  principalOutstanding   Decimal          @default(0) @db.Decimal(24, 4)
  interestReceivable     Decimal          @default(0) @db.Decimal(24, 4)
  feesReceivable         Decimal          @default(0) @db.Decimal(24, 4)
  penaltyReceivable      Decimal          @default(0) @db.Decimal(24, 4)
  instalmentAmount       Decimal?         @db.Decimal(24, 4)
  daysPastDue            Int              @default(0)
  delinquencyBucket      String           @default("CURRENT")
  collectionStage        String?
  disbursementDate       DateTime?        @db.Date
  maturityDate           DateTime?        @db.Date
  lastAccrualDate        DateTime?        @db.Date
  closedAt               DateTime?
  writtenOffAt           DateTime?
  /// Refinancing: the loan this one replaced, and the one that replaced it.
  /// Both are kept so a chain of refinances is traceable in either direction.
  refinancedFromLoanId   String?
  refinancedByLoanId     String?
  /// How many times this borrowing has been refinanced, carried down the chain.
  refinanceCount         Int              @default(0)
  /// Restructuring: the loan stays flagged; executing a restructure does not reset delinquency.
  isRestructured         Boolean          @default(false)
  restructureCount       Int              @default(0)
  lastRestructuredAt     DateTime?
  /// Bucket held during probation so a restructure alone never reclassifies the loan as performing.
  delinquencyFloorBucket String?
  delinquencyFloorDpd    Int?
  probationRemaining     Int              @default(0)
  /// Optimistic concurrency token; every financial mutation bumps it.
  version                Int              @default(0)
  createdBy              String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  instalments      ScheduleInstalment[]
  events           FinancialEvent[]
  restructureCases RestructureCase[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@unique([tenantId, agreementId])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
}

/// A contractual floating-rate re-pricing applied to a booked loan.
///
/// Append-only: one row per reset date per loan, recording the observation it
/// priced off, what the benchmark would have given before any floor or cap,
/// and the agreement version it produced. Re-pricing is never an edit — the
/// schedule it replaced survives as the previous AgreementVersion.
model RateReset {
  id                 String   @id @default(uuid())
  tenantId           String
  loanAccountId      String
  agreementId        String
  /// The contractual reset date.
  resetDate          DateTime @db.Date
  /// The period start the new rate took effect from.
  effectiveFrom      DateTime @db.Date
  benchmarkCode      String
  observationDate    DateTime @db.Date
  /// The benchmark itself, before the margin.
  observedRate       Decimal  @db.Decimal(18, 10)
  margin             Decimal  @db.Decimal(18, 10)
  /// benchmark + margin, before any floor or cap.
  indicatedRate      Decimal  @db.Decimal(18, 10)
  /// BENCHMARK, FLOOR, CAP
  bound              String
  previousAnnualRate Decimal  @db.Decimal(18, 10)
  newAnnualRate      Decimal  @db.Decimal(18, 10)
  /// The agreement version this reset created.
  agreementVersion   Int
  instalmentAmount   Decimal? @db.Decimal(24, 4)
  /// Engine inputs, the re-priced lines and the explanation, for audit.
  calculation        Json
  engineVersion      String
  appliedBy          String
  createdAt          DateTime @default(now())

  @@unique([loanAccountId, resetDate])
  @@unique([tenantId, id])
  @@index([tenantId, loanAccountId, resetDate])
}

/// A published payment-holiday offer.
///
/// A programme is not a hardship case: it is an offer the lender must apply
/// consistently, so its eligibility is evaluated from recorded loan state
/// rather than an officer's judgement.
model PaymentHolidayProgramme {
  id                     String   @id @default(uuid())
  tenantId               String
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  /// DRAFT, OPEN, CLOSED
  status                 String   @default("DRAFT")
  maxInstalments         Int
  /// PAY_SEPARATELY, DEFER_NO_CAPITALIZATION, CAPITALIZE, WAIVE
  interestTreatment      String
  /// EXTEND_TERM, KEEP_MATURITY
  termTreatment          String
  opensOn                DateTime @db.Date
  closesOn               DateTime @db.Date
  minInstalmentsPaid     Int      @default(0)
  maxDaysPastDue         Int      @default(30)
  minInstalmentsRemaining Int     @default(1)
  maxHolidaysPerLoan     Int      @default(1)
  allowRestructured      Boolean  @default(false)
  version                Int      @default(0)
  createdBy              String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  enrolments PaymentHolidayEnrolment[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// One loan's holiday under a programme. Append-only: a holiday that is
/// granted is part of the loan's history, and a correction is a reversal of
/// the amendment it produced, not an edit here.
model PaymentHolidayEnrolment {
  id               String                  @id @default(uuid())
  tenantId         String
  programmeId      String
  programme        PaymentHolidayProgramme @relation(fields: [tenantId, programmeId], references: [tenantId, id], onDelete: Cascade)
  loanAccountId    String
  borrowerId       String
  instalments      Int
  effectiveDate    DateTime                @db.Date
  /// First due date the borrower pays again.
  resumesOn        DateTime                @db.Date
  /// Interest arising during the holiday, and what became of it.
  deferredInterest Decimal                 @db.Decimal(24, 4)
  interestTreatment String
  termTreatment    String
  /// The agreement version the holiday produced.
  agreementVersion Int
  /// Engine inputs, the rescheduled lines and the explanation, for audit.
  calculation      Json
  engineVersion    String
  grantedBy        String
  createdAt        DateTime                @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, loanAccountId])
  @@index([tenantId, programmeId])
}

/// What a refinance did: the loan replaced, the loan that replaced it, and
/// the supervisory facts about whether arrears were rolled forward.
/// Append-only.
model RefinanceRecord {
  id                String   @id @default(uuid())
  tenantId          String
  /// The loan being replaced.
  previousLoanId    String
  /// The loan whose proceeds settled it.
  newLoanId         String   @unique
  borrowerId        String
  payoffAmount      Decimal  @db.Decimal(24, 4)
  appliedToPayoff   Decimal  @db.Decimal(24, 4)
  topUpToBorrower   Decimal  @db.Decimal(24, 4)
  shortfallPaid     Decimal  @db.Decimal(24, 4)
  arrears           Decimal  @db.Decimal(24, 4)
  /// Arrears funded by the new loan rather than repaid by the borrower.
  arrearsRolledIn   Decimal  @db.Decimal(24, 4)
  previousDaysPastDue Int
  /// Replaced a delinquent loan AND funded its arrears.
  evergreening      Boolean
  calculation       Json
  engineVersion     String
  executedBy        String
  createdAt         DateTime @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, previousLoanId])
  @@index([tenantId, borrowerId])
}

model ScheduleInstalment {
  id                     String      @id @default(uuid())
  tenantId               String
  loanAccountId          String
  loanAccount            LoanAccount @relation(fields: [tenantId, loanAccountId], references: [tenantId, id], onDelete: Cascade)
  agreementVersion       Int
  number                 Int
  periodStart            DateTime    @db.Date
  periodEnd              DateTime    @db.Date
  dueDate                DateTime    @db.Date
  openingPrincipal       Decimal     @db.Decimal(24, 4)
  principalDue           Decimal     @db.Decimal(24, 4)
  interestDue            Decimal     @db.Decimal(24, 4)
  capitalizedInterest    Decimal     @default(0) @db.Decimal(24, 4)
  feeDue                 Decimal     @default(0) @db.Decimal(24, 4)
  taxDue                 Decimal     @default(0) @db.Decimal(24, 4)
  penaltyDue             Decimal     @default(0) @db.Decimal(24, 4)
  principalPaid          Decimal     @default(0) @db.Decimal(24, 4)
  interestPaid           Decimal     @default(0) @db.Decimal(24, 4)
  feePaid                Decimal     @default(0) @db.Decimal(24, 4)
  taxPaid                Decimal     @default(0) @db.Decimal(24, 4)
  penaltyPaid            Decimal     @default(0) @db.Decimal(24, 4)
  /// Pre-existing arrears carried into this line by a restructure: repaid as INTEREST, never accrued again.
  deferredInterestDue    Decimal     @default(0) @db.Decimal(24, 4)
  /// Interest earned on this line up to the restructure that closed it (status RESTRUCTURED).
  accruedAtClose         Decimal?    @db.Decimal(24, 4)
  annualRate             Decimal     @db.Decimal(18, 10)
  projected              Boolean     @default(false)
  /// DUE, PAID, SUPERSEDED
  status                 String      @default("DUE")
  penaltyAssessedThrough DateTime?   @db.Date
  createdAt              DateTime    @default(now())

  @@index([tenantId, loanAccountId, status])
}

model AccrualEvent {
  id               String   @id @default(uuid())
  tenantId         String
  loanAccountId    String
  financialEventId String   @unique
  /// Accrued up to (not including) this date.
  accrualDate      DateTime @db.Date
  amount           Decimal  @db.Decimal(24, 4)
  createdAt        DateTime @default(now())

  @@index([tenantId, loanAccountId, accrualDate])
}

/// Immutable financial event. Corrections are REVERSAL events, never edits.
model FinancialEvent {
  id                String      @id @default(uuid())
  tenantId          String
  loanAccountId     String
  loanAccount       LoanAccount @relation(fields: [tenantId, loanAccountId], references: [tenantId, id], onDelete: Cascade)
  /// DISBURSEMENT, REPAYMENT, ACCRUAL, PENALTY, SETTLEMENT, WRITE_OFF, RECOVERY, REVERSAL
  type              String
  /// POSTED, REVERSED
  status            String      @default("POSTED")
  businessDate      DateTime    @db.Date
  valueDate         DateTime    @db.Date
  amount            Decimal     @db.Decimal(24, 4)
  currency          String
  components        Json
  idempotencyKey    String
  requestHash       String
  reversalOfId      String?     @unique
  productVersionId  String
  agreementVersion  Int
  engineVersion     String
  actorId           String
  actorType         String
  externalReference String?
  narrative         String      @default("")
  createdAt         DateTime    @default(now())

  allocations PaymentAllocation[]
  journal     LendingJournalEntry?

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, loanAccountId, createdAt])
}

model PaymentAllocation {
  id               String         @id @default(uuid())
  tenantId         String
  financialEventId String
  event            FinancialEvent @relation(fields: [tenantId, financialEventId], references: [tenantId, id], onDelete: Cascade)
  loanAccountId    String
  instalmentNumber Int
  /// PENALTY, FEE, TAX, INTEREST, PRINCIPAL
  component        String
  amount           Decimal        @db.Decimal(24, 4)

  @@index([tenantId, financialEventId])
}

model LendingJournalEntry {
  id               String               @id @default(uuid())
  tenantId         String
  financialEventId String               @unique
  event            FinancialEvent       @relation(fields: [tenantId, financialEventId], references: [tenantId, id], onDelete: Cascade)
  loanAccountId    String
  entryDate        DateTime             @db.Date
  currency         String
  description      String
  createdAt        DateTime             @default(now())
  lines            LendingJournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, financialEventId])
  @@index([tenantId, entryDate])
}

model LendingJournalLine {
  id            String              @id @default(uuid())
  tenantId      String
  entryId       String
  entry         LendingJournalEntry @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount       @relation(fields: [tenantId, accountId], references: [tenantId, id])
  accountCode   String
  loanAccountId String
  debit         Decimal             @default(0) @db.Decimal(24, 4)
  credit        Decimal             @default(0) @db.Decimal(24, 4)

  @@index([tenantId, accountCode])
  @@index([tenantId, loanAccountId])
}

// ── Restructuring and hardship ─────────────────────────────────────────────

/// Tenant affordability policy (buffers, DSCR, evidence rules). Versioned, maker-checker.
model AffordabilityPolicy {
  id        String    @id @default(uuid())
  tenantId  String
  version   Int
  settings  Json
  /// SUBMITTED, ACTIVE, REJECTED, RETIRED
  status    String    @default("SUBMITTED")
  makerId   String
  checkerId String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([tenantId, version])
}

/// A restructuring / hardship review of one loan. A customer request opens a
/// review; it never changes terms by itself.
model RestructureCase {
  id                   String      @id @default(uuid())
  tenantId             String
  tenant               Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reference            String
  loanAccountId        String
  loanAccount          LoanAccount @relation(fields: [tenantId, loanAccountId], references: [tenantId, id], onDelete: Cascade)
  borrowerId           String
  branchId             String
  portfolioId          String?
  /// CUSTOMER_REQUEST, STAFF_ON_CUSTOMER_REQUEST, COLLECTIONS, CREDIT_REVIEW, SYSTEM_REFERRAL
  trigger              String
  initiatorType        String
  initiatorId          String
  channel              String
  /// ILLNESS, JOB_LOSS, INCOME_REDUCTION, BUSINESS_DOWNTURN, DELAYED_HARVEST, DISASTER, OTHER
  hardshipCategory     String
  /// TEMPORARY or PERSISTENT
  difficultyType       String
  customerStatement    String      @default("")
  requestedRelief      Json
  consentRecorded      Boolean     @default(false)
  consentReference     String?
  expectedRecoveryDate DateTime?   @db.Date
  previousRestructures Int         @default(0)
  /// REQUESTED, MORE_INFO_REQUIRED, AFFORDABILITY_ASSESSED, SPECIALIST_REVIEW, OPTIONS_PROPOSED,
  /// APPROVED, CUSTOMER_ACCEPTED, CONDITIONS_SATISFIED, MONITORING, COMPLETED,
  /// REJECTED, WITHDRAWN, EXPIRED, REVERSED
  status               String      @default("REQUESTED")
  specialistReview     Boolean     @default(false)
  outcomeNote          String?
  version              Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  evidence    RestructureEvidence[]
  assessments AffordabilityAssessment[]
  proposals   RestructureProposal[]
  conditions  RestructureCondition[]
  reviewTasks RestructureReviewTask[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, loanAccountId])
}

model RestructureEvidence {
  id          String          @id @default(uuid())
  tenantId    String
  caseId      String
  case        RestructureCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  /// INCOME, EXPENSES, DEBTS, BUSINESS_CASHFLOW, HARVEST_FORECAST, MEDICAL, EMPLOYMENT, OTHER
  type        String
  description String
  /// SELF_DECLARED, PARTIALLY_VERIFIED, VERIFIED
  quality     String
  documentRef String?
  providedBy  String
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime        @default(now())

  @@index([tenantId, caseId])
}

/// Immutable affordability assessment with evidence quality and assumptions.
model AffordabilityAssessment {
  id               String          @id @default(uuid())
  tenantId         String
  caseId           String
  case             RestructureCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  /// INDIVIDUAL, HOUSEHOLD, BUSINESS, SEASONAL
  template         String
  inputs           Json
  result           Json
  policySettings   Json
  policyVersion    String
  evidenceQuality  String
  assumptions      String
  verificationDate DateTime        @db.Date
  assessorId       String
  comments         String          @default("")
  sustainable      Boolean
  createdAt        DateTime        @default(now())

  @@index([tenantId, caseId])
}

/// A versioned proposal. Any change after approval or acceptance is a new version.
model RestructureProposal {
  id                String          @id @default(uuid())
  tenantId          String
  caseId            String
  case              RestructureCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  version           Int
  /// PROPOSED, APPROVED, REJECTED, ACCEPTED, EXECUTED, SUPERSEDED, EXPIRED
  status            String          @default("PROPOSED")
  effectiveDate     DateTime        @db.Date
  options           Json
  /// Immutable balance snapshot the proposal was calculated on.
  snapshot          Json
  calculation       Json
  comparison        Json
  concessions       Json
  policyExceptions  Json
  requiredFlags     String[]
  approvalsRequired Int             @default(1)
  proposalHash      String
  assessmentId      String?
  proposedBy        String
  expiresAt         DateTime
  createdAt         DateTime        @default(now())

  approvals   RestructureApproval[]
  acceptances RestructureAcceptance[]

  @@unique([caseId, version])
  @@unique([tenantId, id])
}

/// Credit/risk approval — recorded separately from customer acceptance.
model RestructureApproval {
  id         String              @id @default(uuid())
  tenantId   String
  proposalId String
  proposal   RestructureProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Cascade)
  approverId String
  /// APPROVE or REJECT
  decision   String
  comment    String
  policy     Json
  createdAt  DateTime            @default(now())

  @@index([tenantId, proposalId])
}

/// Customer acceptance of one exact proposal version (bound by its hash).
model RestructureAcceptance {
  id             String              @id @default(uuid())
  tenantId       String
  proposalId     String
  proposal       RestructureProposal @relation(fields: [tenantId, proposalId], references: [tenantId, id], onDelete: Cascade)
  /// CUSTOMER (self-service) or STAFF_ON_BEHALF (witnessed)
  acceptedByType String
  acceptedById   String
  /// PORTAL_CONFIRMATION, SIGNED_FORM, WITNESSED_VERBAL
  method         String
  evidence       String
  proposalHash   String
  createdAt      DateTime            @default(now())

  @@index([tenantId, proposalId])
}

model RestructureCondition {
  id         String          @id @default(uuid())
  tenantId   String
  caseId     String
  case       RestructureCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  code       String
  label      String
  mandatory  Boolean         @default(true)
  /// OUTSTANDING, SATISFIED, WAIVED
  status     String          @default("OUTSTANDING")
  evidence   String?
  resolvedBy String?
  resolvedAt DateTime?

  @@unique([caseId, code])
}

/// Monitoring and follow-up. A task asks for review; it never grants concessions.
model RestructureReviewTask {
  id        String          @id @default(uuid())
  tenantId  String
  caseId    String
  case      RestructureCase @relation(fields: [tenantId, caseId], references: [tenantId, id], onDelete: Cascade)
  /// MISSED_REVISED_PAYMENT, RELIEF_EXPIRY, PROBATION_REVIEW, BALLOON_MATURITY, AFFORDABILITY_REFRESH, REPEAT_REQUEST
  type      String
  dueDate   DateTime        @db.Date
  /// OPEN, CLOSED
  status    String          @default("OPEN")
  detail    Json
  dedupeKey String
  closedBy  String?
  closedAt  DateTime?
  createdAt DateTime        @default(now())

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, dueDate])
}

/// The executed amendment: links the case, proposal, agreement versions and accounting event.
model LoanAmendment {
  id                   String   @id @default(uuid())
  tenantId             String
  loanAccountId        String
  caseId               String
  proposalId           String   @unique
  fromAgreementVersion Int
  toAgreementVersion   Int
  effectiveDate        DateTime @db.Date
  beforeSnapshot       Json
  afterSnapshot        Json
  financialEventId     String
  executedBy           String
  /// EXECUTED, REVERSED
  status               String   @default("EXECUTED")
  reversalEventId      String?
  createdAt            DateTime @default(now())

  @@index([tenantId, loanAccountId])
}

/// Transactional outbox: written with the business change, delivered by a worker.
model OutboxMessage {
  id          String    @id @default(uuid())
  tenantId    String
  topic       String
  payload     Json
  /// PENDING, SENT, FAILED
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt])
}

/// Immutable lending audit trail, including authorization decisions.
model AuditEvent {
  id             String    @id @default(uuid())
  tenantId       String?
  actorId        String
  actorType      String
  action         String
  resourceType   String
  resourceId     String
  /// ALLOW, DENY, SUCCESS, FAILURE
  outcome        String
  decision       Json?
  details        Json?
  configVersions Json?
  businessDate   DateTime? @db.Date
  eventTime      DateTime  @default(now())

  @@index([tenantId, eventTime])
  @@index([tenantId, resourceType, resourceId])
}
