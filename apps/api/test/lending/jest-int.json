{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../..",
  "testEnvironment": "node",
  "testRegex": "test/lending/.*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 60000,
  "moduleNameMapper": {
    "^otplib$": "<rootDir>/test/lending/stubs/otplib.ts"
  },
  "forceExit": true,
  "testSequencer": "<rootDir>/test/lending/sequencer.js"
}
