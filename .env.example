# DATABASE
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public"

# AUTH
JWT_ACCESS_SECRET="<MIN_32_CHARS_RANDOM_SECRET>"
JWT_REFRESH_SECRET="<MIN_32_CHARS_RANDOM_SECRET>"
JWT_REFRESH_TOKEN_PEPPER="<MIN_16_CHARS_RANDOM_PEPPER>"
# Durations: 90s, 15m, 2h or 30d (a malformed value stops the API at boot).
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Account lockout after repeated failed passwords / TOTP codes.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=30
# Lifetime of the second-factor challenge after a correct password.
AUTH_MFA_CHALLENGE_TTL="5m"
# Lifetime of an emailed password-reset link.
AUTH_PASSWORD_RESET_MINUTES=60
# Platform super-administrators must enrol an authenticator and sign in with
# it before any platform route answers (D-128). Leave on in production.
AUTH_MFA_REQUIRED_SUPERADMIN=true
# An MFA-gated action needs an authenticator code at most this many minutes
# old; an older session is asked for a fresh code (step-up, D-129).
AUTH_MFA_STEP_UP_MINUTES=15

# FIELD ENCRYPTION AT REST (AES-256-GCM)
# 32-byte key, base64 or 64-char hex. Encrypts twoFactorSecret, KYC document
# images, and the Telegram bot token at rest. REQUIRED in production (the api
# refuses to boot without it). Outside production, if unset, a key is derived
# from JWT_ACCESS_SECRET. Escrow it outside the hosting platform: a backup is
# unreadable without it (DEPLOYMENT.md -> Secrets and key escrow).
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="<BASE64_32_BYTE_KEY>"

# GOOGLE SIGN-IN / SIGN-UP
# Unset = the feature is fully dormant: /auth/providers reports disabled, the
# web sign-in button does not render, and the Google CSP allowances are not
# added. Set the OAuth 2.0 Web client ID from the Google Cloud console.
GOOGLE_CLIENT_ID="<GOOGLE_OAUTH_WEB_CLIENT_ID>"
# Optional comma-separated Workspace domain allowlist. Empty = any Google
# account may sign in (subject to the account already existing, or to
# self-serve workspace signup).
GOOGLE_ALLOWED_DOMAINS=""

# SELF-SERVE WORKSPACE SIGNUP — PLAN PRICING
# REMOVED. Plans are no longer configured here.
#
# Subscription tiers — name, price, currency and every quota — are rows in the
# PlanTier table, managed by the platform owner under
# Platform ops → Subscription Plans. Add, reprice and retire tiers there; no
# deploy and no environment change is involved.
#
# The plan-tier migration seeds the four tiers that used to be hardcoded, at
# their previous prices. If you had overridden a price with PLAN_PRICE_*, SQL
# could not read it — re-enter the real price in the UI after deploying. The API
# logs a warning at boot while any PLAN_PRICE_* variable is still set.
#
#   PLAN_PRICE_CURRENCY, PLAN_PRICE_BASIC,
#   PLAN_PRICE_PROFESSIONAL, PLAN_PRICE_ENTERPRISE   — all now ignored

# SIGNUP PAYMENT QR (KHQR / Bakong)
# PREFERRED: upload your merchant QR in the SUPERADMIN panel
# (Platform ops → Payments). It is digested into merchant details and every
# plan's payment code is generated from it with the correct price embedded —
# no env vars needed, and the operator can see exactly what customers scan.
#
# The variables below are a FALLBACK, used only when nothing has been uploaded.
# Either way, paid signup is rejected up front when no merchant is available,
# so only the FREE plan can be selected — no half-created workspaces.
# There is no Bakong settlement API here, so a SUPERADMIN confirms receipt via
# PUT /v1/tenants/plan-payments/:id/confirm, which is the only thing that moves
# a workspace out of PENDING_PAYMENT.
KHQR_BAKONG_ACCOUNT_ID="<BAKONG_ACCOUNT_ID e.g. acme@devb>"
KHQR_MERCHANT_NAME="<MERCHANT_NAME max 25 chars>"
KHQR_MERCHANT_CITY="Phnom Penh"
KHQR_MERCHANT_CATEGORY_CODE="6012"

# STRIPE PLAN PRICE IDS (optional, for in-app upgrades after activation)
# Keys must match the plan names above. STRIPE_PRICE_PRO is accepted as a
# legacy alias for STRIPE_PRICE_PROFESSIONAL.
STRIPE_SECRET_KEY="<STRIPE_SECRET_KEY>"
STRIPE_PRICE_BASIC="<STRIPE_PRICE_ID>"
STRIPE_PRICE_PROFESSIONAL="<STRIPE_PRICE_ID>"
STRIPE_PRICE_ENTERPRISE="<STRIPE_PRICE_ID>"
# STRIPE_PRICE_PRO=<legacy alias of STRIPE_PRICE_PROFESSIONAL>
STRIPE_WEBHOOK_SECRET="<STRIPE_WEBHOOK_SIGNING_SECRET>"
# How long an unpaid signup payment QR stays valid.
SIGNUP_PAYMENT_TTL_DAYS=7
# Days between a workspace erasure request and the earliest permitted purge
# (enforced, D-131).
TENANT_ERASURE_GRACE_DAYS=30
# How long a request awaiting a second super-administrator stays open.
PLATFORM_APPROVAL_TTL_DAYS=7
# Longest the database part of a tenant purge may run (milliseconds).
TENANT_PURGE_TX_TIMEOUT_MS=300000

# TENANT ISOLATION (Chinese wall)
# The Prisma tenant guard rejects any query against a tenant-owned table that
# is not scoped to the caller's tenant. SUPERADMIN (platform owner) is
# unrestricted; trusted paths with no request principal — login, token
# validation, cron jobs — declare themselves via runAsSystem()/@SystemContext().
#
# Leave unset (= "enforce") in production. "warn" downgrades an unscoped query
# from a 403 to a log line, and exists only as a rollout escape hatch.
TENANT_GUARD_MODE="enforce"
# Refuse to start when the database role bypasses row-level security. Set
# "true" in production, with DATABASE_URL naming the role created by
# ops/db/app-role.sql (migrations use the owner, MIGRATION_DATABASE_URL, which
# only the start command reads).
DB_ROLE_MUST_RESPECT_RLS=false

# CORS
CORS_ORIGINS="http://localhost:3000"
# Legacy single-origin name, read only when CORS_ORIGINS is unset.
# CORS_ORIGIN="http://localhost:3000"
PORT=3001
# Public origin of the web app, for links in emails and payment redirects.
# Unset: the first CORS origin (production requires CORS_ORIGINS anyway).
WEB_URL="http://localhost:3000"
# Largest JSON / form request body.
API_BODY_LIMIT="5mb"
# Seconds the readiness probe waits for the database.
READINESS_DB_TIMEOUT_MS=2000

# PLATFORM IDENTITY
# The platform's name in emails, chat-bot messages, authenticator labels and
# the webhook User-Agent.
PLATFORM_NAME="Magic Money"

# RATE LIMIT (required in production)
# When set, rate-limit counters live in Redis and every API instance shares
# them; unset (development only), one process counts in memory.
REDIS_URL="redis://localhost:6379"
# Requests per second per signed-in user (per IP when signed out).
RATE_LIMIT_PER_SECOND=120

# WEB -> API CLIENT IDENTITY (set the SAME value on api AND web; recommended)
# The web server calls the API server-to-server, so without this the API sees
# the web server's address for every browser (one throttle bucket, one audit
# IP). With it, the web server states the browser IP in X-Client-IP and proves
# it with X-Web-Proxy-Secret; the API believes X-Client-IP only then.
# At least 32 random characters, e.g. `openssl rand -hex 32`. Unset: the API
# ignores X-Client-IP (and logs a warning in production).
WEB_PROXY_SECRET="<RANDOM_32_PLUS_CHARS>"

# OBSERVABILITY (error tracking + tracing) — no-op if unset
SENTRY_DSN="<SENTRY_PROJECT_DSN>"
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Release tag for Sentry; Railway sets it.
# RAILWAY_GIT_COMMIT_SHA=
# Prometheus scrape: bearer token, or allow scrapes from private networks.
METRICS_BEARER_TOKEN="<RANDOM_TOKEN>"
METRICS_ALLOW_PRIVATE_NETWORK=false

# DOCUMENT STORAGE (required in production)
# Production requires AWS_REGION whenever AWS_S3_BUCKET_NAME is set.
AWS_REGION="<AWS_REGION>"
AWS_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
AWS_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
AWS_S3_BUCKET_NAME="<AWS_S3_BUCKET_NAME>"
# Without S3: a directory for customer documents. With several API instances
# it must be a volume every instance mounts.
# DOCUMENT_STORAGE_DIR=/data/documents
# Key for encrypting customer documents stored on disk (AES-256-GCM per file,
# data keys wrapped under a key derived from this one): 32 bytes as base64 or
# 64 hex characters, kept apart from FIELD_ENCRYPTION_KEY. REQUIRED in
# production whenever S3 is not configured. Losing it makes every encrypted
# file unreadable; back it up with the volume. Existing plaintext files are
# encrypted with: pnpm encrypt:documents
DOCUMENT_ENCRYPTION_KEY="<BASE64_32_BYTE_KEY>"
# Largest document upload (bytes) and signed download-link lifetime (30..900 s).
DOCUMENT_UPLOAD_MAX_BYTES=10485760
DOCUMENT_LINK_TTL_SECONDS=300
# Secret for API-served document links, >= 32 chars. REQUIRED in production;
# outside production it falls back to a key derived from JWT_ACCESS_SECRET.
DOCUMENT_LINK_SECRET="<MIN_32_CHARS_RANDOM_SECRET>"
# Daily document-expiry reminders: schedule, lead time, off switch.
DOCUMENT_EXPIRY_CRON="45 0 * * *"
DOCUMENT_EXPIRY_REMINDER_DAYS=30
DOCUMENT_EXPIRY_DISABLED=false

# EMAIL AND SMS (optional; no-op when unset)
# Production requires EMAIL_FROM whenever RESEND_API_KEY is set.
RESEND_API_KEY="<RESEND_API_KEY>"
EMAIL_FROM="<SENDER_ADDRESS>"
# Provider endpoint (default: Resend's public API).
# EMAIL_API_URL=https://api.resend.com/emails
SMS_API_URL="<SMS_GATEWAY_URL>"
SMS_API_KEY="<SMS_GATEWAY_KEY>"

# TELEGRAM BOT AND AI ASSISTANT (optional; bots are off without OPENAI_API_KEY)
OPENAI_API_KEY="<OPENAI_API_KEY>"
OPENAI_MODEL="gpt-4o"
# Polling is leased per tenant in the database, so one instance polls each
# bot; set false on instances that should only send.
TELEGRAM_POLLING_ENABLED=true

# Bootstrap scripts
BOOTSTRAP_SUPERADMIN_EMAIL="<SUPERADMIN_EMAIL>"
BOOTSTRAP_SUPERADMIN_PASSWORD="<STRONG_SUPERADMIN_PASSWORD>"

# CREDIT BUREAU CAMBODIA (CBC)
# When both are set, live CBC enquiries are used; otherwise credit checks are
# unavailable (there is no sandbox that could fabricate a bureau score).
CBC_API_URL="<CBC_MEMBER_API_URL>"
CBC_API_KEY="<CBC_MEMBER_API_KEY>"

# WEB
# The web server reaches the API at API_URL (server-only, preferred) or
# NEXT_PUBLIC_API_URL; production requires one of them. On Railway, API_URL
# can use private networking: http://api.railway.internal:<api PORT>/v1
API_URL="http://localhost:3001/v1"
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
NEXT_PUBLIC_CLARITY_PROJECT_ID="<MICROSOFT_CLARITY_PROJECT_ID>"
# Who operates this deployment, as the public legal and pricing pages say.
# Unset: the original operator's details.
NEXT_PUBLIC_OPERATOR_NAME="<LEGAL_ENTITY_NAME>"
NEXT_PUBLIC_PRODUCT_NAME="<PRODUCT_NAME>"
NEXT_PUBLIC_CONTACT_EMAIL_DOMAIN="<CONTACT_EMAIL_DOMAIN>"
# Override any single contact address:
# NEXT_PUBLIC_SUPPORT_EMAIL= NEXT_PUBLIC_PRIVACY_EMAIL= NEXT_PUBLIC_BILLING_EMAIL= NEXT_PUBLIC_SALES_EMAIL=

# ── Lending platform (optional) ─────────────────────────────────────────────
# Pepper for service-account integration keys, >= 32 chars. REQUIRED in
# production; outside production it falls back to JWT_REFRESH_TOKEN_PEPPER.
# Changing it invalidates every issued service key.
SERVICE_KEY_PEPPER=<random-32+-chars>
# Set to "true" to stop the transactional-outbox delivery worker.
LENDING_OUTBOX_DISABLED=false
# Set to "false" to skip syncing the lending catalogue (families, templates, permissions, flags) on boot.
LENDING_CATALOGUE_SYNC=true
# Automatic end-of-day: rolls each tenant's business date to today and runs the
# servicing batch (accrual, penalties, delinquency, rate resets, monitoring).
# One API instance runs it at a time (Postgres advisory lock).
LENDING_EOD_DISABLED=false
LENDING_EOD_CRON="15 0 * * *"
LENDING_EOD_TZ="Asia/Phnom_Penh"
# Most days caught up in one run after downtime.
LENDING_EOD_MAX_CATCHUP_DAYS=31
# Loans processed in parallel per tenant (default from the connection pool).
# LENDING_EOD_CONCURRENCY=4
# Metrics gauges refresh and the six-hourly reconciliation monitor.
LENDING_METRICS_REFRESH_SECONDS=60
LENDING_METRICS_REFRESH_DISABLED=false
LENDING_RECONCILIATION_CRON="40 */6 * * *"
LENDING_RECONCILIATION_JOB_DISABLED=false
# Development only: MOCK uses fixed FX rates instead of the tenant rate table (refused in production).
# LENDING_FX_SOURCE=MOCK

# Transactional outbox and webhooks: delivery limits.
LENDING_OUTBOX_MAX_ATTEMPTS=20
LENDING_OUTBOX_BATCH_SIZE=50
LENDING_WEBHOOKS_DISABLED=false
LENDING_WEBHOOK_MAX_ATTEMPTS=15
LENDING_WEBHOOK_DISABLE_AFTER_FAILURES=50
LENDING_WEBHOOK_TIMEOUT_MS=10000
LENDING_WEBHOOK_BATCH_SIZE=100
LENDING_WEBHOOK_FANOUT_BATCH_SIZE=500
# How long an instance owns a message or delivery it is sending before
# another instance may pick it up.
LENDING_DELIVERY_LEASE_SECONDS=120
# Development only: allow webhook endpoints on private networks (never in production).
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Most loans one migration file may carry.
LENDING_MIGRATION_MAX_ROWS=10000
# Reuse of a built authorization subject/context while its version is unchanged,
# and the bound on each in-process memo.
LENDING_AUTHZ_CACHE_TTL_MS=30000
LENDING_AUTHZ_CACHE_MAX_ENTRIES=5000
# The regulator's ceiling on the annual interest rate (%): a lender may set a
# lower cap, never a higher one. Default: the NBC cap.
REGULATORY_MAX_ANNUAL_RATE_PCT=18

# Original (legacy) loan book jobs: schedules, in LENDING_EOD_TZ (the tenant's
# local zone, Asia/Phnom_Penh by default). While the legacy book is read-only
# (the default, D-097) the penalty job skips the tenant.
LEGACY_PENALTY_CRON="0 0 * * *"
LEGACY_REMINDER_CRON="0 8 * * *"
LEGACY_UPCOMING_REMINDER_CRON="0 9 * * *"
LEGACY_LATE_ALERT_CRON="0 10 * * *"
COLLECTIONS_PTP_REVIEW_CRON="30 1 * * *"
# Longest a legacy provisioning run's transaction may take (ms).
LEGACY_PROVISIONING_TX_TIMEOUT_MS=120000

# Borrower self-service portal: session and one-time codes.
BORROWER_TOKEN_TTL="2h"
BORROWER_OTP_TTL_SECONDS=300
BORROWER_OTP_MAX_ATTEMPTS=5
BORROWER_OTP_MAX_PER_WINDOW=3
BORROWER_OTP_WINDOW_MINUTES=15
# Integration tests only: a throwaway database whose name contains "test" or "ci".
# LENDING_TEST_DATABASE_URL=<postgres connection string>

# Demo seed (pnpm demo:lending; refused in production unless DEMO_SEED_ALLOW=true).
# Unset DEMO_PASSWORD: a random password is generated and printed.
# DEMO_PASSWORD=<password for demo users>
# DEMO_SEED_ALLOW=false
