# DATABASE
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public"

# AUTH
JWT_ACCESS_SECRET="<MIN_32_CHARS_RANDOM_SECRET>"
JWT_REFRESH_SECRET="<MIN_32_CHARS_RANDOM_SECRET>"
JWT_REFRESH_TOKEN_PEPPER="<MIN_16_CHARS_RANDOM_PEPPER>"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# FIELD ENCRYPTION AT REST (AES-256-GCM)
# 32-byte key, base64 or 64-char hex. Encrypts twoFactorSecret, KYC document
# images, and the Telegram bot token at rest. If unset, a key is derived from
# JWT_ACCESS_SECRET (works, but set a dedicated key before rotating that secret).
# Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="<BASE64_32_BYTE_KEY>"

# CORS
CORS_ORIGINS="http://localhost:3000"
PORT=3001

# RATE LIMIT (required in production)
REDIS_URL="redis://localhost:6379"

# OBSERVABILITY (error tracking + tracing) — no-op if unset
SENTRY_DSN="<SENTRY_PROJECT_DSN>"
SENTRY_TRACES_SAMPLE_RATE="0.1"

# DOCUMENT STORAGE (required in production)
AWS_REGION="<AWS_REGION>"
AWS_ACCESS_KEY_ID="<AWS_ACCESS_KEY_ID>"
AWS_SECRET_ACCESS_KEY="<AWS_SECRET_ACCESS_KEY>"
AWS_S3_BUCKET_NAME="<AWS_S3_BUCKET_NAME>"

# Bootstrap scripts
BOOTSTRAP_SUPERADMIN_EMAIL="<SUPERADMIN_EMAIL>"
BOOTSTRAP_SUPERADMIN_PASSWORD="<STRONG_SUPERADMIN_PASSWORD>"

# CREDIT BUREAU CAMBODIA (CBC)
# When both are set, live CBC enquiries are used; otherwise a deterministic
# sandbox provider is used (non-production credit checks).
CBC_API_URL="<CBC_MEMBER_API_URL>"
CBC_API_KEY="<CBC_MEMBER_API_KEY>"

# WEB
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
NEXT_PUBLIC_CLARITY_PROJECT_ID="<MICROSOFT_CLARITY_PROJECT_ID>"
